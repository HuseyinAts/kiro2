# KIRO2 MVP Beta - Environment Variables
# Copy to .env.mvp and fill in real values:
#   cp .env.mvp.example .env.mvp

# Database (host.docker.internal = host machine from Docker)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@host.docker.internal:5434/kiro2

# Redis
REDIS_URL=redis://host.docker.internal:6379/0

# Environment
ENVIRONMENT=development
DEBUG=false
PYTHONUNBUFFERED=1

# Security - GENERATE THESE! Do not use defaults in production.
# openssl rand -base64 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64
JWT_ALGORITHM=HS256
# openssl rand -base64 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Feature Flags
FEATURE_2FA_ENABLED=false
