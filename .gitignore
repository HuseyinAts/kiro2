# Minimal AI Education Platform
# Simple .gitignore for minimal system

# Leaked secrets / session cookies (NEVER commit)
cookies*.txt

# Python
__pycache__/
*.py[cod]
# Local OpenAPI dump for security audits (regenerate with backend/scripts/dump_openapi.py)
openapi_snapshot.json
*.pyc
.Python
venv/
env/

# Environment Variables (CRITICAL: Never commit sensitive data)
.env
.env.local
.env.production
.env.development
.env.test
*.env.backup
.env.*
!.env.mvp.example

# Node.js
node_modules/
npm-debug.log*
.npm

# IDE
.vscode/
.idea/
*.swp
*.swo

# Deprecated directories
kiro2-orchestrator/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporary
*.tmp
temp/
tmp/

# Build
dist/
build/
# Database
*.db
*.sqlite
*.sqlite3

# Test Coverage
htmlcov/
.coverage
.coverage.*
coverage.json
*.cover
.pytest_cache/

# Docker
docker-compose.override.yml

# Secrets & Keys
*.pem
*.key
*.crt
*.p12
secrets/
.secrets/

# Cache
.cache/
*.cache

# Backups
backups/*.rdb
backups/*.aof
backups/*.dump
backups/*.sql
backups/*.sql.gz
*.backup

# Vector DB (binary data, regenerated at runtime)
**/vector_db/
**/test_vector_db/

# Uploads
uploads/*
!uploads/.gitkeep

# Reports
reports/*.html
reports/*.json
reports/*.xml

# Alembic
*.pyc
alembic/versions/*.pyc
backend/api/nul

# Windows nul device files
nul
*/nul

# Git submodules
mcp-servers/

