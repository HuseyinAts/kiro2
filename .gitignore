uploads/*
!uploads/.gitkeep

# Reports
reports/*.html
reports/*.json
reports/*.xml

# Alembic
*.pyc
alembic/versions/*.pyc
backend/api/nul

# Windows nul device files
nul
*/nul

# Git submodules
