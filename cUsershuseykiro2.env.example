# KIRO2 - Ortam Degiskenleri Template
ENVIRONMENT=development
DEBUG=true

# Veritabani - Development (local): port 5434
DB_HOST=localhost
DB_PORT=5434
DB_NAME=kiro2
DB_USER=postgres
DB_PASSWORD=postgres

# Async Driver URL (FastAPI)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/kiro2

# Sync Driver URL (Alembic migrations)
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5434/kiro2

# Test
USE_POSTGRES_TESTS=false
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Redis
REDIS_URL=redis://localhost:6379/0

# Guvenlik
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
