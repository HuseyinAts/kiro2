# KIRO2 MVP / Beta launch environment template.
# Copy to .env.mvp (in project root) and fill REAL values.
# NEVER commit .env.mvp itself.
#
# Setup:
#   cp docs/setup/env.mvp.example .env.mvp
#   # edit secrets
#   docker compose up -d

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# NOTE: ENVIRONMENT=production hardens config validation (password complexity,
# CORS strict). For local/dev use 'development' to avoid crash loop.

# -----------------------------------------------------------------------------
# Database (PostgreSQL 18, host-side, port 5434)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@host.docker.internal:5434/kiro2
DB_HOST=host.docker.internal
DB_PORT=5434
DB_NAME=kiro2
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Connection pool (DB Performance audit: keep below PG max_connections=100)
db_pool_size=15
db_pool_max_overflow=30
db_pool_timeout=30
db_pool_recycle=1800

# -----------------------------------------------------------------------------
# Redis (in kiro2-redis container, see docker-compose.yml)
# -----------------------------------------------------------------------------
REDIS_URL=redis://kiro2-redis:6379/0
REDIS_HOST=kiro2-redis
REDIS_PORT=6379
REDIS_DB=0

# -----------------------------------------------------------------------------
# JWT / Auth
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_RUN_PYTHON_SECRETS_TOKEN_URLSAFE_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seed (used by backend/seed_admin.py)
ADMIN_SEED_EMAIL=admin@kiro2.com
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of frontend origins. Production: include real domain.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Frontend build args (read by docker-compose.yml at build time)
# -----------------------------------------------------------------------------
VITE_SHOW_DEMO=false
# Used by build-time demo button if VITE_SHOW_DEMO=true; baked into image so
# rotate before publishing builds.
VITE_DEMO_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# LLM providers (optional, leave blank to disable)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# YouTube data API (for video recommendations)
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Optional: ChromaDB (vector store). Leave CHROMADB_HOST blank for embedded.
# -----------------------------------------------------------------------------
CHROMADB_HOST=
CHROMADB_PORT=8000
CHROMADB_PERSIST_DIR=/app/vector_db

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Rate limiting (workload-simulator audit: 10/60s blocks shared-NAT WiFi)
# -----------------------------------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=30
GENERAL_RATE_LIMIT_PER_MINUTE=100

# -----------------------------------------------------------------------------
# Pre-flight one-shot setup (one time per environment)
# -----------------------------------------------------------------------------
#   docker network create kiro2_turkiye_sinav_network || true
#   docker volume create kiro2_redis-data || true
