[pytest]
# ============================================================================
# TEST DISCOVERY CONFIGURATION
# ============================================================================
# Test discovery paths - include all except explicitly excluded
testpaths = tests

# Test file patterns (pytest defaults, explicitly defined for clarity)
python_files = test_*.py
python_classes = Test*
python_functions = test_*

# ============================================================================
# COMMAND LINE OPTIONS
# ============================================================================
addopts =
    # Verbosity and output
    -v
    --tb=short

    # Marker validation
    --strict-markers

    # Warning filters (more specific than --disable-warnings)
    -W ignore::DeprecationWarning
    -W ignore::PytestUnraisableExceptionWarning
    -W ignore::ResourceWarning

    # Failure handling
    --maxfail=50

    # Performance (REMOVED: -p no:cacheprovider for better performance)

    # Output formatting
    --color=yes

# ============================================================================
# EXCLUDED DIRECTORIES
# ============================================================================
norecursedirs =
    tests/slow
    tests/fixtures
    tests/load
    tests/accessibility
    .git
    .tox
    __pycache__
    *.egg-info
    dist
    build
    venv
    env

# ============================================================================
# CUSTOM TEST MARKERS
# ============================================================================
markers =
    fast: Fast unit tests (runs in < 1s)
    integration: Integration tests (requires database)
    slow: Slow tests (runs in > 10s)
    unit: Unit tests with mocks
    e2e: End-to-end tests
    smoke: Smoke tests for quick validation
    regression: Regression tests

# ============================================================================
# ASYNC TEST CONFIGURATION
# ============================================================================
asyncio_mode = auto

# ============================================================================
# TIMEOUT CONFIGURATION
# ============================================================================
# Default timeout: 60 seconds (use @pytest.mark.timeout(N) for exceptions)
timeout = 60
timeout_method = thread

# ============================================================================
# COVERAGE CONFIGURATION
# ============================================================================
# Use: pytest --cov=. --cov-report=html --cov-report=json:coverage.json
# Coverage settings are in .coveragerc

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
log_cli = false
log_cli_level = INFO
log_cli_format = %(asctime)s [%(levelname)8s] %(message)s
log_cli_date_format = %Y-%m-%d %H:%M:%S

# File logging
log_file = pytest.log
log_file_level = DEBUG
log_file_format = %(asctime)s [%(levelname)8s] %(name)s - %(message)s
log_file_date_format = %Y-%m-%d %H:%M:%S

# ============================================================================
# COLLECTION CONFIGURATION
# ============================================================================
# Consider all tests as non-cached to avoid stale results
# (Cache is enabled for performance but can be cleared with: pytest --cache-clear)
