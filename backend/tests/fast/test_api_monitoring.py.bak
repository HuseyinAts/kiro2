class TestQueryParameterValidation:
    """Test query parameter validation"""

    @patch('api.monitoring.performance_monitor')
    def test_hours_parameter_minimum(self, mock_monitor, client):
        """Test hours parameter minimum validation"""
        mock_monitor.get_api_performance_summary.return_value = {}

        response = client.get("/api/v1/monitoring/performance/api?hours=0")

        assert response.status_code == 422  # Validation error

    @patch('api.monitoring.performance_monitor')
    def test_hours_parameter_maximum(self, mock_monitor, client):
        """Test hours parameter maximum validation"""
        mock_monitor.get_api_performance_summary.return_value = {}

        response = client.get("/api/v1/monitoring/performance/api?hours=25")

        assert response.status_code == 422  # Validation error

    @patch('api.monitoring.performance_monitor')
    def test_interval_seconds_validation(self, mock_monitor, client):
        """Test interval_seconds parameter validation"""
        mock_monitor.is_monitoring = False
        mock_monitor.start_monitoring = AsyncMock()

        # Test minimum
        response = client.post("/api/v1/monitoring/monitoring/start?interval_seconds=5")
        assert response.status_code == 422

        # Test maximum
        response = client.post("/api/v1/monitoring/monitoring/start?interval_seconds=400")
        assert response.status_code == 422
