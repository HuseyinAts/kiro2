"""
Comprehensive tests for api/monitoring.py
Tests monitoring API endpoints for health checks and performance metrics
"""
import pytest
from fastapi import FastAPI
from fastapi.testclient import TestClient
from unittest.mock import patch, AsyncMock, MagicMock
from datetime import datetime


@pytest.fixture
def test_app():
    """Create test app with monitoring router"""
    # Mock the missing performance_monitor module before importing
    import sys
    from unittest.mock import MagicMock

    mock_monitor = MagicMock()
    mock_monitor.is_monitoring = False
    mock_monitor.get_api_performance_summary.return_value = {}
    mock_monitor.get_db_performance_summary.return_value = {}
    mock_monitor.get_system_performance_summary.return_value = {}
    mock_monitor.export_metrics_to_prometheus.return_value = ""
    mock_monitor.start_monitoring = AsyncMock()
    mock_monitor.stop_monitoring = AsyncMock()

    sys.modules['core.performance_monitor'] = MagicMock(performance_monitor=mock_monitor)

    from api.monitoring import router
    app = FastAPI()
    app.include_router(router)
    return app


@pytest.fixture
def client(test_app):
    """Create test client"""
    return TestClient(test_app)


@pytest.fixture
def mock_performance_monitor():
    """Mock performance monitor"""
    monitor = MagicMock()
    monitor.is_monitoring = False
    monitor.get_api_performance_summary.return_value = {
        "avg_response_time_ms": 150.5,
        "total_requests": 1000
    }
    monitor.get_db_performance_summary.return_value = {
        "avg_execution_time_ms": 50.2,
        "total_queries": 500
    }
    monitor.get_system_performance_summary.return_value = {
        "cpu": {"avg_percent": 45.0},
        "memory": {"avg_percent": 60.0}
    }
    monitor.export_metrics_to_prometheus.return_value = "# HELP metric_name Description\nmetric_name 100"
    return monitor


class TestHealthCheckEndpoint:
    """Test /api/v1/monitoring/health endpoint"""

    @patch('api.monitoring.logger')
    @patch('api.monitoring.get_db_session')
    @patch('api.monitoring.performance_monitor')
    def test_health_check_all_healthy(self, mock_monitor, mock_db_session, mock_logger, client):
        """Test health check when all services are healthy"""
        # Mock database session
        mock_session = AsyncMock()
        mock_session.__aenter__.return_value = mock_session
        mock_session.__aexit__.return_value = None
        mock_session.execute = AsyncMock()
        mock_db_session.return_value = mock_session

        # Mock performance monitor
        mock_monitor.is_monitoring = True

        response = client.get("/api/v1/monitoring/health")

        assert response.status_code == 200
        data = response.json()
        assert data["success"] is True
        assert "data" in data
        assert data["data"]["status"] in ["healthy", "degraded"]

    @patch('api.monitoring.logger')
    @patch('api.monitoring.get_db_session')
    @patch('api.monitoring.performance_monitor')
    def test_health_check_response_structure(self, mock_monitor, mock_db_session, mock_logger, client):
        """Test health check response structure"""
        mock_session = AsyncMock()
        mock_session.__aenter__.return_value = mock_session
        mock_session.__aexit__.return_value = None
        mock_session.execute = AsyncMock()
        mock_db_session.return_value = mock_session
        mock_monitor.is_monitoring = True

        response = client.get("/api/v1/monitoring/health")
        data = response.json()

        assert "success" in data
        assert "data" in data
        assert "message" in data
        assert "status" in data["data"]
        assert "timestamp" in data["data"]
        assert "version" in data["data"]
        assert "services" in data["data"]

    @patch('api.monitoring.get_db_session')
    @patch('api.monitoring.performance_monitor')
    def test_health_check_database_unhealthy(self, mock_monitor, mock_db_session, client):
        """Test health check when database is unhealthy"""
        # Mock database failure
        async def raise_error(*args, **kwargs):
            raise Exception("Database connection failed")

        mock_session = AsyncMock()
        mock_session.__aenter__.return_value = mock_session
        mock_session.__aexit__.return_value = None
        mock_session.execute = raise_error
        mock_db_session.return_value = mock_session
        mock_monitor.is_monitoring = True

        response = client.get("/api/v1/monitoring/health")

        assert response.status_code == 200
        data = response.json()
        assert data["data"]["status"] == "degraded"
        assert "database" in data["data"]["services"]
        assert "unhealthy" in data["data"]["services"]["database"]


class TestAPIPerformanceEndpoint:
    """Test /api/v1/monitoring/performance/api endpoint"""

    @patch('api.monitoring.performance_monitor')
    def test_get_api_performance_default(self, mock_monitor, client):
        """Test API performance with default parameters"""
        mock_monitor.get_api_performance_summary.return_value = {
            "avg_response_time_ms": 150.5,
            "total_requests": 1000
        }

        response = client.get("/api/v1/monitoring/performance/api")

        assert response.status_code == 200
        data = response.json()
        assert data["success"] is True
        assert "data" in data
        assert data["data"]["avg_response_time_ms"] == 150.5

    @patch('api.monitoring.performance_monitor')
    def test_get_api_performance_with_hours(self, mock_monitor, client):
        """Test API performance with custom hours parameter"""
        mock_monitor.get_api_performance_summary.return_value = {
            "avg_response_time_ms": 200.0
        }

        response = client.get("/api/v1/monitoring/performance/api?hours=12")

        assert response.status_code == 200
        data = response.json()
        assert "12 hours" in data["message"]

    @patch('api.monitoring.performance_monitor')
    def test_get_api_performance_error(self, mock_monitor, client):
        """Test API performance error handling"""
        mock_monitor.get_api_performance_summary.side_effect = Exception("Monitor error")

        response = client.get("/api/v1/monitoring/performance/api")

        assert response.status_code == 500


