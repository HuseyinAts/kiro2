class TestBottlenecksEndpoint:
    """Test /api/v1/monitoring/bottlenecks endpoint"""

    @patch('api.monitoring.performance_monitor')
    def test_detect_bottlenecks_none_found(self, mock_monitor, client):
        """Test bottleneck detection with no issues"""
        mock_monitor.get_api_performance_summary.return_value = {"avg_response_time_ms": 100}
        mock_monitor.get_db_performance_summary.return_value = {"avg_execution_time_ms": 50}
        mock_monitor.get_system_performance_summary.return_value = {
            "cpu": {"avg_percent": 30},
            "memory": {"avg_percent": 40}
        }

        response = client.get("/api/v1/monitoring/bottlenecks")

        assert response.status_code == 200
        data = response.json()
        assert data["success"] is True
        assert len(data["data"]["bottlenecks"]) == 0

    @patch('api.monitoring.performance_monitor')
    def test_detect_bottlenecks_api_slow(self, mock_monitor, client):
        """Test bottleneck detection for slow API"""
        mock_monitor.get_api_performance_summary.return_value = {"avg_response_time_ms": 1500}
        mock_monitor.get_db_performance_summary.return_value = {"avg_execution_time_ms": 50}
        mock_monitor.get_system_performance_summary.return_value = {
            "cpu": {"avg_percent": 30},
            "memory": {"avg_percent": 40}
        }

        response = client.get("/api/v1/monitoring/bottlenecks")

        assert response.status_code == 200
        data = response.json()
        assert len(data["data"]["bottlenecks"]) > 0
        assert any(b["type"] == "api_performance" for b in data["data"]["bottlenecks"])
        assert any(b["severity"] == "high" for b in data["data"]["bottlenecks"])

    @patch('api.monitoring.performance_monitor')
    def test_detect_bottlenecks_high_cpu(self, mock_monitor, client):
        """Test bottleneck detection for high CPU"""
        mock_monitor.get_api_performance_summary.return_value = {"avg_response_time_ms": 100}
        mock_monitor.get_db_performance_summary.return_value = {"avg_execution_time_ms": 50}
        mock_monitor.get_system_performance_summary.return_value = {
            "cpu": {"avg_percent": 90},
            "memory": {"avg_percent": 40}
        }

        response = client.get("/api/v1/monitoring/bottlenecks")

        assert response.status_code == 200
        data = response.json()
        assert len(data["data"]["bottlenecks"]) > 0
        assert any(b["type"] == "cpu_usage" for b in data["data"]["bottlenecks"])

    @patch('api.monitoring.performance_monitor')
    def test_detect_bottlenecks_high_memory(self, mock_monitor, client):
        """Test bottleneck detection for high memory"""
        mock_monitor.get_api_performance_summary.return_value = {"avg_response_time_ms": 100}
        mock_monitor.get_db_performance_summary.return_value = {"avg_execution_time_ms": 50}
        mock_monitor.get_system_performance_summary.return_value = {
            "cpu": {"avg_percent": 30},
            "memory": {"avg_percent": 95}
        }

        response = client.get("/api/v1/monitoring/bottlenecks")

        assert response.status_code == 200
        data = response.json()
        assert len(data["data"]["bottlenecks"]) > 0
        assert any(b["type"] == "memory_usage" for b in data["data"]["bottlenecks"])


class TestMonitoringControlEndpoints:
    """Test /api/v1/monitoring/monitoring/start and stop endpoints"""

    @patch('api.monitoring.performance_monitor')
    def test_start_monitoring(self, mock_monitor, client):
        """Test starting performance monitoring"""
        mock_monitor.is_monitoring = False
        mock_monitor.start_monitoring = AsyncMock()

        response = client.post("/api/v1/monitoring/monitoring/start")

        assert response.status_code == 200
        data = response.json()
        assert data["success"] is True
        assert "started" in data["message"]

    @patch('api.monitoring.performance_monitor')
    def test_start_monitoring_already_running(self, mock_monitor, client):
        """Test starting monitoring when already running"""
        mock_monitor.is_monitoring = True

        response = client.post("/api/v1/monitoring/monitoring/start")

        assert response.status_code == 200
        data = response.json()
        assert "already running" in data["message"]

    @patch('api.monitoring.performance_monitor')
    def test_start_monitoring_with_interval(self, mock_monitor, client):
        """Test starting monitoring with custom interval"""
        mock_monitor.is_monitoring = False
        mock_monitor.start_monitoring = AsyncMock()

        response = client.post("/api/v1/monitoring/monitoring/start?interval_seconds=60")

        assert response.status_code == 200
        data = response.json()
        assert "60s" in data["message"]

    @patch('api.monitoring.performance_monitor')
    def test_stop_monitoring(self, mock_monitor, client):
        """Test stopping performance monitoring"""
        mock_monitor.is_monitoring = True
        mock_monitor.stop_monitoring = AsyncMock()

        response = client.post("/api/v1/monitoring/monitoring/stop")

        assert response.status_code == 200
        data = response.json()
        assert data["success"] is True
        assert "stopped" in data["message"]

    @patch('api.monitoring.performance_monitor')
    def test_stop_monitoring_not_running(self, mock_monitor, client):
        """Test stopping monitoring when not running"""
        mock_monitor.is_monitoring = False

        response = client.post("/api/v1/monitoring/monitoring/stop")

        assert response.status_code == 200
        data = response.json()
        assert "not running" in data["message"]


