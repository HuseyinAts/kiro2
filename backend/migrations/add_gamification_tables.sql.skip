-- Task 91: Gamification System - Database Migration
-- Adds tables and fields for gamification features

-- ============================================================================
-- 1. Add gamification fields to users table
-- ============================================================================

-- Add total_xp column if it doesn't exist
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                   WHERE table_name = 'users' AND column_name = 'total_xp') THEN
        ALTER TABLE users ADD COLUMN total_xp INTEGER DEFAULT 0 NOT NULL;
    END IF;
END $$;

-- Add level column if it doesn't exist
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                   WHERE table_name = 'users' AND column_name = 'level') THEN
        ALTER TABLE users ADD COLUMN level INTEGER DEFAULT 1 NOT NULL;
    END IF;
END $$;

-- Add last_level_up_at column if it doesn't exist
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                   WHERE table_name = 'users' AND column_name = 'last_level_up_at') THEN
        ALTER TABLE users ADD COLUMN last_level_up_at TIMESTAMP WITH TIME ZONE;
    END IF;
END $$;

-- Add indexes for performance
CREATE INDEX IF NOT EXISTS idx_users_level ON users(level);
CREATE INDEX IF NOT EXISTS idx_users_total_xp ON users(total_xp);

-- ============================================================================
-- 2. Create user_badges table
-- ============================================================================

CREATE TABLE IF NOT EXISTS user_badges (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id VARCHAR NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    badge_id VARCHAR(100) NOT NULL,

    -- Earning information
    earned_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    auto_awarded BOOLEAN DEFAULT TRUE,

    -- Constraints
    CONSTRAINT uq_user_badge UNIQUE (user_id, badge_id)
);

-- Indexes
CREATE INDEX IF NOT EXISTS idx_user_badges_user_id ON user_badges(user_id);
CREATE INDEX IF NOT EXISTS idx_user_badges_badge_id ON user_badges(badge_id);
CREATE INDEX IF NOT EXISTS idx_user_badges_earned_at ON user_badges(earned_at);

-- ============================================================================
-- 3. Create leaderboard_entries table (for snapshots)
-- ============================================================================

CREATE TABLE IF NOT EXISTS leaderboard_entries (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id VARCHAR NOT NULL REFERENCES users(id) ON DELETE CASCADE,

    -- Leaderboard information
    leaderboard_type VARCHAR(50) NOT NULL,  -- 'global', 'weekly', 'monthly', etc.
    period VARCHAR(50) NOT NULL,  -- '2025-01', '2025-W42', etc.

    -- Score information
    score INTEGER DEFAULT 0 NOT NULL,
    rank INTEGER,

    -- Timestamps
    recorded_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL
);

-- Indexes for efficient queries
CREATE INDEX IF NOT EXISTS idx_leaderboard_type_period_score
    ON leaderboard_entries(leaderboard_type, period, score DESC);
CREATE INDEX IF NOT EXISTS idx_leaderboard_user_type_period
    ON leaderboard_entries(user_id, leaderboard_type, period);
CREATE INDEX IF NOT EXISTS idx_leaderboard_recorded_at
    ON leaderboard_entries(recorded_at);

-- ============================================================================
-- 4. Verify point_transactions table exists
-- ============================================================================

-- This table should already exist, but we'll create it if it doesn't
CREATE TABLE IF NOT EXISTS point_transactions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id VARCHAR NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    points INTEGER NOT NULL,
    reason VARCHAR(255) NOT NULL,
    metadata JSONB,
    timestamp TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL
);

-- Indexes
CREATE INDEX IF NOT EXISTS idx_point_transactions_user_id ON point_transactions(user_id);
CREATE INDEX IF NOT EXISTS idx_point_transactions_timestamp ON point_transactions(timestamp);

-- ============================================================================
-- 5. Create function to update updated_at timestamp
-- ============================================================================

CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Add trigger for leaderboard_entries
DROP TRIGGER IF EXISTS update_leaderboard_entries_updated_at ON leaderboard_entries;
CREATE TRIGGER update_leaderboard_entries_updated_at
    BEFORE UPDATE ON leaderboard_entries
    FOR EACH ROW
    EXECUTE FUNCTION update_updated_at_column();

