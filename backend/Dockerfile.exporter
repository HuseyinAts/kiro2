# Dockerfile for Prometheus Exporter
# Video API Monitoring - Task 19

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy monitoring module
COPY monitoring/ ./monitoring/
COPY __init__.py .

# Expose Prometheus metrics port
EXPOSE 9091

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:9091/metrics')"

# Run Prometheus exporter
CMD ["python", "-m", "monitoring.prometheus_exporter"]
