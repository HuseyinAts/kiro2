# Minimal Backend Dockerfile
# For current implementation with in-memory storage
FROM python:3.11-slim

# Working directory
WORKDIR /app

# Install only essential system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    espeak-ng \
    espeak-ng-data \
    && rm -rf /var/lib/apt/lists/*

# Copy and install minimal Python dependencies
COPY requirements-minimal.txt .
RUN pip install --no-cache-dir -r requirements-minimal.txt

# Copy application
COPY . .

# Create necessary directories
RUN mkdir -p /app/vector_db /app/data /app/logs

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Non-root user
RUN addgroup --system kiro2 && adduser --system --ingroup kiro2 kiro2
RUN chown -R kiro2:kiro2 /app
USER kiro2

# Production start command (no --reload)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]