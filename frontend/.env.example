# ==============================================================================
# KIRO2 Frontend Environment Configuration
# ==============================================================================
#
# Bu dosya KIRO2 platformu için gerekli tüm environment variable'ları içerir.
# Kendi .env dosyanızı oluşturmak için:
#   cp .env.example .env
#
# ⚠️  GÜVENLİK UYARISI:
# - .env dosyasını asla git'e commit ETMEYİN!
# - Production secret'ları bu dosyaya YAZMAYIN!
# - API key'leri CI/CD pipeline'da environment variable olarak set edin
#
# 📚 Daha fazla bilgi: /frontend/docs/ENVIRONMENT_VARIABLES.md
# ==============================================================================

# ------------------------------------------------------------------------------
# API CONFIGURATION
# Backend API endpoint'leri ve timeout ayarları
# ------------------------------------------------------------------------------

# Backend API base URL
# Development: http://localhost:8000
# Production: https://api.kiro2.com
VITE_API_URL=http://localhost:8000

# WebSocket URL (gerçek zamanlı sınav güncellemeleri için)
# Development: ws://localhost:8000
# Production: wss://api.kiro2.com
VITE_WS_URL=ws://localhost:8000

# API request timeout (milliseconds)
# Önerilen: 30000 (30 saniye) - normal istekler
# Batch operations için daha yüksek olabilir
VITE_API_TIMEOUT=30000

# WebSocket connection timeout (milliseconds)
# Önerilen: 5000 (5 saniye)
VITE_WS_TIMEOUT=5000

# API retry configuration
# Max retry attempts on network failures
VITE_API_MAX_RETRIES=3

# Retry delay in milliseconds (with exponential backoff)
VITE_API_RETRY_DELAY=1000

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# Uygulama genel ayarları
# ------------------------------------------------------------------------------

# Application name (UI'da gösterilir)
VITE_APP_NAME=KIRO2 - Türkiye'nin Eğitim Platformu

# Application version (semantic versioning)
# Format: MAJOR.MINOR.PATCH
VITE_APP_VERSION=2.0.0

# Environment (development | staging | production | test)
# Bu değer hata raporlama, logging seviyesi, vs. için kullanılır
VITE_APP_ENV=development

# Base URL (frontend domain)
# Development: http://localhost:3000
# Production: https://kiro2.com
VITE_APP_URL=http://localhost:3000

# Public URL (CDN veya static assets için)
# Development: http://localhost:3000
# Production: https://cdn.kiro2.com
VITE_PUBLIC_URL=/

# ------------------------------------------------------------------------------
# FEATURE FLAGS
# Özellikleri açıp kapatmak için flag'ler
# ------------------------------------------------------------------------------

# Enable Google Analytics tracking
# true = Production, false = Development
VITE_ENABLE_ANALYTICS=false

# Enable debug mode (console logs, detailed errors)
# true = Development, false = Production
VITE_ENABLE_DEBUG=true

# Enable WebSocket (real-time exam updates)
# NOT: Backend'de şu an disable - false yapın
VITE_ENABLE_WEBSOCKET=false

# Enable service worker (offline support, PWA)
VITE_ENABLE_SERVICE_WORKER=false

# Enable Sentry error tracking
# true = Production, false = Development
VITE_ENABLE_SENTRY=false

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Enable A/B testing
VITE_ENABLE_AB_TESTING=false

# Enable experimental features
# Yeni özellikleri test etmek için
VITE_ENABLE_EXPERIMENTAL=false

# Show demo login buttons (dev/staging only)
# VITE_SHOW_DEMO=false
# Demo login password (only set in dev/staging .env, NEVER commit real value)
# VITE_DEMO_PASSWORD=

# ------------------------------------------------------------------------------
# EXAM CONFIGURATION
# Sınav sistemi ayarları (TYT/AYT/YDT)
# ------------------------------------------------------------------------------

# Enable exam timer
VITE_EXAM_ENABLE_TIMER=true

# Enable question flagging
VITE_EXAM_ENABLE_FLAGGING=true

# Enable exam review mode
VITE_EXAM_ENABLE_REVIEW=true

# Auto-save interval for exam answers (milliseconds)
# Önerilen: 30000 (30 saniye)
VITE_EXAM_AUTOSAVE_INTERVAL=30000

# Exam session storage type (localStorage | sessionStorage | indexedDB)
VITE_EXAM_STORAGE_TYPE=localStorage

# Maximum exam duration extension (minutes)
# Erişilebilirlik için ek süre
VITE_EXAM_MAX_EXTENSION=30

# ------------------------------------------------------------------------------
# ACCESSIBILITY SETTINGS
# Erişilebilirlik özellikleri (disleksi, DEHB, vs.)
# ------------------------------------------------------------------------------

# Enable screen reader support
VITE_ACCESSIBILITY_SCREEN_READER=true

# Enable high contrast mode
VITE_ACCESSIBILITY_HIGH_CONTRAST=true

# Enable dyslexia-friendly fonts
VITE_ACCESSIBILITY_DYSLEXIA_FONT=true

# Enable text-to-speech
VITE_ACCESSIBILITY_TEXT_TO_SPEECH=false

# Default font size (px)
VITE_ACCESSIBILITY_DEFAULT_FONT_SIZE=16

# ------------------------------------------------------------------------------
# CACHE & PERFORMANCE
# Önbellek ve performans ayarları
# ------------------------------------------------------------------------------

# Cache TTL for API responses (seconds)
# Önerilen: 300 (5 dakika)
VITE_CACHE_TTL=300

# Enable service worker caching
VITE_CACHE_ENABLE_SW=false

# Enable localStorage caching
VITE_CACHE_ENABLE_LOCAL=true

# Maximum cache size (MB)
VITE_CACHE_MAX_SIZE=50

# Enable image lazy loading
VITE_PERFORMANCE_LAZY_LOAD_IMAGES=true

# Enable code splitting
VITE_PERFORMANCE_CODE_SPLITTING=true

# Bundle size warning threshold (KB)
VITE_PERFORMANCE_BUNDLE_WARNING=500

# ------------------------------------------------------------------------------
# SECURITY
# Güvenlik ayarları
# ------------------------------------------------------------------------------

# Sentry DSN (error tracking)
# Production için gerekli
# Format: https://<key>@<organization>.ingest.sentry.io/<project>
VITE_SENTRY_DSN=

# Sentry environment
VITE_SENTRY_ENVIRONMENT=development

# Sentry traces sample rate (0.0 to 1.0)
# 1.0 = Tüm request'leri trace et (development)
# 0.1 = %10'unu trace et (production)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Allowed CORS origins (comma-separated)
VITE_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Enable CSRF protection
VITE_SECURITY_CSRF_ENABLED=true

# Token expiration time (seconds)
# 3600 = 1 saat
VITE_TOKEN_EXPIRATION=3600

# ------------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS
# 3. parti servis entegrasyonları
# ------------------------------------------------------------------------------

# Google Analytics Measurement ID
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Google reCAPTCHA site key
# V3 invisible captcha için
VITE_RECAPTCHA_SITE_KEY=

# YouTube API key (EBA TV entegrasyonu için)
VITE_YOUTUBE_API_KEY=

# Cloudflare turnstile site key
VITE_TURNSTILE_SITE_KEY=

# ------------------------------------------------------------------------------
# FILE UPLOAD SETTINGS
# Dosya yükleme ayarları (PDF, resim, vs.)
# ------------------------------------------------------------------------------

# Maximum file size for uploads (MB)
# Önerilen: 10 MB
VITE_UPLOAD_MAX_SIZE=10

# Allowed file types (comma-separated MIME types)
VITE_UPLOAD_ALLOWED_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Upload chunk size for large files (bytes)
# 1MB chunks for resumable uploads
VITE_UPLOAD_CHUNK_SIZE=1048576

# ------------------------------------------------------------------------------
# VIDEO PLAYER SETTINGS
# EBA TV ve video player ayarları
# ------------------------------------------------------------------------------

# Enable video playback tracking
VITE_VIDEO_ENABLE_TRACKING=true

# Video quality presets (auto | 360p | 480p | 720p | 1080p)
VITE_VIDEO_DEFAULT_QUALITY=auto

# Enable video subtitles
VITE_VIDEO_ENABLE_SUBTITLES=true

# Video player buffer size (seconds)
VITE_VIDEO_BUFFER_SIZE=10

# Enable video download
VITE_VIDEO_ENABLE_DOWNLOAD=false

# ------------------------------------------------------------------------------
# LEARNING PATH SETTINGS
# Öğrenme yolu ve AI özellikleri
# ------------------------------------------------------------------------------

# Enable AI-powered learning path recommendations
VITE_LEARNING_PATH_AI_ENABLED=true

# Enable FSRS (Free Spaced Repetition Scheduler)
VITE_LEARNING_PATH_FSRS_ENABLED=true

# Enable multi-agent coordination
VITE_LEARNING_PATH_MULTI_AGENT=true

# Learning path cache TTL (seconds)
VITE_LEARNING_PATH_CACHE_TTL=600

# ------------------------------------------------------------------------------
# PARENT DASHBOARD SETTINGS
# Veli paneli ayarları
# ------------------------------------------------------------------------------

# Enable parent notifications
VITE_PARENT_NOTIFICATIONS_ENABLED=true

# Notification check interval (milliseconds)
# Önerilen: 60000 (1 dakika)
VITE_PARENT_NOTIFICATION_INTERVAL=60000

# Enable child performance tracking
VITE_PARENT_TRACKING_ENABLED=true

# Weekly report generation day (0=Sunday, 1=Monday, etc.)
VITE_PARENT_REPORT_DAY=0

# ------------------------------------------------------------------------------
# TESTING CONFIGURATION
# Test ortamı ayarları
# ------------------------------------------------------------------------------

# Enable test mode
# true = E2E testleri için mock data kullan
VITE_TEST_MODE=false

# Test API URL (mock server)
VITE_TEST_API_URL=http://localhost:8001

# Enable visual regression testing
VITE_TEST_VISUAL_REGRESSION=false

# Test timeout (milliseconds)
VITE_TEST_TIMEOUT=10000

# ------------------------------------------------------------------------------
# LOGGING & MONITORING
# Loglama ve monitoring ayarları
# ------------------------------------------------------------------------------

# Log level (debug | info | warn | error)
VITE_LOG_LEVEL=info

# Enable console logs
VITE_LOG_CONSOLE_ENABLED=true

# Enable remote logging (to backend)
VITE_LOG_REMOTE_ENABLED=false

# Log sampling rate (0.0 to 1.0)
# 1.0 = Tüm logları gönder
# 0.1 = %10'unu gönder
VITE_LOG_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# DEVELOPER TOOLS
# Geliştirici araçları (sadece development)
# ------------------------------------------------------------------------------

# Enable React DevTools
VITE_DEV_REACT_DEVTOOLS=true

# Enable Redux DevTools
VITE_DEV_REDUX_DEVTOOLS=true

# Enable performance profiler
VITE_DEV_PROFILER=false

# Enable bundle analyzer
VITE_DEV_BUNDLE_ANALYZER=false

# Hot reload delay (milliseconds)
VITE_DEV_HMR_DELAY=0

# ==============================================================================
# NOTLAR
# ==============================================================================
#
# 1. Boolean değerler: "true" veya "false" (string olarak)
# 2. Number değerler: Doğrudan sayı yazın (quotes olmadan)
# 3. Array değerler: Virgülle ayırın (comma-separated)
# 4. Environment-specific değerler: .env.development, .env.production kullanın
# 5. Secret değerler: CI/CD pipeline'da set edin, .env dosyasına YAZMAYIN
#
# 📖 Detaylı dokümantasyon:
#    - /frontend/docs/ENVIRONMENT_VARIABLES.md
#    - /frontend/DATE_HANDLING_GUIDE.md
#
# 🔒 Güvenlik:
#    - .env dosyası .gitignore'da olmalı
#    - Production secret'ları environment variable olarak set edin
#    - API key'leri asla client-side'da kullanmayın
#
# ==============================================================================