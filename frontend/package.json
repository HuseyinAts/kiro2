{
  "name": "teknofest-egitim-frontend",
  "version": "1.0.0",
  "description": "Teknofest 2025 Eğitim Eylemci Frontend",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.14.0",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.6.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.0",
    "framer-motion": "^10.18.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.0",
    "react-markdown": "^9.0.0",
    "react-query": "^3.39.0",
    "react-router-dom": "^6.30.1",
    "react-syntax-highlighter": "^5.8.0",
    "react-window": "^2.2.3",
    "recharts": "^2.15.4",
    "web-vitals": "^5.1.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.55.0",
    "jest-axe": "^8.0.0",
    "jsdom": "^23.0.0",
    "msw": "^2.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.1.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.13",
    "terser": "^5.24.0",
    "typescript": "^5.3.0",
    "vite": "^7.1.6",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "workbox-window": "^7.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "NODE_ENV=production tsc && vite build --mode production",
    "build:fast": "vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 3000",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage --reporter=default --reporter=json --reporter=html",
    "test:ui": "vitest --ui",
    "test:unit": "vitest --run src/**/*.{test,spec}.{ts,tsx}",
    "test:integration": "vitest --run src/services/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:accessibility": "vitest --run src/test/accessibility/**/*.test.ts",
    "test:performance": "vitest --run src/test/performance/**/*.test.ts",
    "test:a11y": "vitest --run --reporter=verbose src/test/accessibility",
    "test:components": "vitest --run src/components/**/*.test.tsx",
    "test:all": "node scripts/test-automation.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "generate:types": "bash ../scripts/generate-types.sh || scripts\\generate-types.bat",
    "generate:types:windows": "scripts\\generate-types.bat",
    "generate:types:unix": "bash ../scripts/generate-types.sh",
    "quality:check": "npm run lint && npm run type-check && npm run test:coverage",
    "quality:fix": "npm run lint:fix && npm run format",
    "clean": "rm -rf dist node_modules/.vite coverage test-reports",
    "clean:all": "npm run clean && rm -rf node_modules package-lock.json"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
