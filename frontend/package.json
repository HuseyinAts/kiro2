{
  "name": "teknofest-egitim-frontend",
  "version": "1.0.0",
  "description": "Teknofest 2025 Eğitim Eylemci Frontend",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lottiefiles/dotlottie-react": "^0.18.7",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.14.0",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.6.0",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.0",
    "dompurify": "^3.3.1",
    "framer-motion": "^10.18.0",
    "katex": "^0.16.38",
    "lodash": "^4.17.21",
    "lucide-react": "^0.263.1",
    "mermaid": "^10.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.0",
    "react-markdown": "^9.0.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.30.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-window": "^2.2.3",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "use-sound": "^5.0.0",
    "web-vitals": "^5.1.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "backstopjs": "^6.3.23",
    "cross-env": "^10.1.0",
    "dexie": "^4.3.0",
    "eslint": "^8.55.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-testing-library": "^7.15.4",
    "jest-axe": "^8.0.0",
    "jsdom": "^23.0.0",
    "msw": "^2.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.1.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.13",
    "terser": "^5.24.0",
    "typescript": "^5.3.0",
    "vite": "^7.1.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4",
    "workbox-window": "^7.4.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "NODE_ENV=production tsc && vite build --mode production",
    "build:fast": "vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 3000",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest --run",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vitest",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=6144 vitest --coverage --reporter=default --reporter=json --reporter=html",
    "test:ui": "vitest --ui",
    "test:unit": "vitest --run src/**/*.{test,spec}.{ts,tsx}",
    "test:integration": "vitest --run src/services/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:noserver": "cross-env SKIP_WEBSERVER=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:accessibility": "vitest --run src/test/accessibility/**/*.test.ts",
    "test:performance": "vitest --run src/test/performance/**/*.test.ts",
    "test:a11y": "vitest --run --reporter=verbose src/test/accessibility",
    "test:components": "vitest --run src/components/**/*.test.tsx",
    "test:all": "node scripts/test-automation.js",
    "test:visual": "backstop test --config=backstop.config.cjs",
    "test:visual:approve": "backstop approve --config=backstop.config.cjs",
    "test:visual:reference": "backstop reference --config=backstop.config.cjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "generate:types": "bash ../scripts/generate-types.sh || scripts\\generate-types.bat",
    "generate:types:windows": "scripts\\generate-types.bat",
    "generate:types:unix": "bash ../scripts/generate-types.sh",
    "quality:check": "npm run lint && npm run type-check && npm run test:coverage",
    "quality:fix": "npm run lint:fix && npm run format",
    "clean": "rm -rf dist node_modules/.vite coverage test-reports",
    "clean:all": "npm run clean && rm -rf node_modules package-lock.json"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
