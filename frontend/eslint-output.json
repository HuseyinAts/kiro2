m\">\r\n            <label htmlFor=\"caption-opacity\">Arka Plan Şeffaflığı:</label>\r\n            <input\r\n              id=\"caption-opacity\"\r\n              type=\"range\"\r\n              min=\"0\"\r\n              max=\"1\"\r\n              step=\"0.05\"\r\n              value={captionSettings.opacity}\r\n              onChange={(e) => setCaptionSettings({ ...captionSettings, opacity: parseFloat(e.target.value) })}\r\n            />\r\n            <span>{Math.round(captionSettings.opacity * 100)}%</span>\r\n          </div>\r\n\r\n          <button onClick={() => setShowSettings(false)} className=\"close-settings\">\r\n            Kapat\r\n          </button>\r\n        </div>\r\n      )}\r\n\r\n      {/* Keyboard Shortcuts Help (Hidden, for screen readers) */}\r\n      <div id=\"video-description\" className=\"visually-hidden\">\r\n        Klavye kısayolları: Boşluk veya K tuşu ile oynat/duraklat,\r\n        Sol/Sağ ok tuşları ile 5 saniye geri/ileri,\r\n        Yukarı/Aşağı ok tuşları ile ses seviyesi,\r\n        M tuşu ile sessize al,\r\n        F tuşu ile tam ekran,\r\n        C tuşu ile altyazı aç/kapat.\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default AccessibleVideoPlayer;\r\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\frontend\\src\\components\\Accessibility\\ColorContrastSettings.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":132,"column":76,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":132,"endColumn