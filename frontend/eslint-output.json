stItemIcon>\n                <ListItemText primary={oneri.oneri || oneri} />\n              </ListItem>\n            ))}\n          </List>\n        ) : (\n          <Typography variant=\"body2\" color=\"textSecondary\">\n            Henüz kişiselleştirilmiş öneri bulunmuyor\n          </Typography>\n        )}\n\n        <Divider sx={{ my: 2 }} />\n\n        <Typography variant=\"h6\" gutterBottom>\n          📈 Gelişim Önerileri\n        </Typography>\n\n        {gelisimOnerileri.length > 0 ? (\n          <List>\n            {gelisimOnerileri.map((oneri, index) => (\n              <ListItem key={index}>\n                <ListItemIcon>\n                  <TrendingUp color=\"success\" />\n                </ListItemIcon>\n                <ListItemText primary={oneri.oneri || oneri} />\n              </ListItem>\n            ))}\n          </List>\n        ) : (\n          <Typography variant=\"body2\" color=\"textSecondary\">\n            Henüz gelişim önerisi bulunmuyor\n          </Typography>\n        )}\n      </DialogContent>\n      <DialogActions>\n        <Button onClick={onClose} variant=\"contained\">\n          Kapat\n        </Button>\n      </DialogActions>\n    </Dialog>\n  );\n};\n\nexport default RecommendationsDialog;\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\frontend\\src\\components\\Exam\\Results\\ResultsEmptyState.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy