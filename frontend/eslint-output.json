t=\"h4\" color=\"info.main\">\r\n                      {serviceStats.avg_processing_time_ms.toFixed(1)}ms\r\n                    </Typography>\r\n                    <Typography variant=\"caption\">Ortalama İşlem Süresi</Typography>\r\n                  </CardContent>\r\n                </Card>\r\n              </Grid>\r\n              <Grid item xs={6}>\r\n                <Card>\r\n                  <CardContent sx={{ textAlign: 'center' }}>\r\n                    <Typography variant=\"h4\">\r\n                      {serviceStats.total_words_processed}\r\n                    </Typography>\r\n                    <Typography variant=\"caption\">İşlenen Kelime</Typography>\r\n                  </CardContent>\r\n                </Card>\r\n              </Grid>\r\n              <Grid item xs={6}>\r\n                <Card>\r\n                  <CardContent sx={{ textAlign: 'center' }}>\r\n                    <Typography variant=\"h4\" color=\"secondary\">\r\n                      {serviceStats.active_users}\r\n                    </Typography>\r\n                    <Typography variant=\"caption\">Aktif Kullanıcı</Typography>\r\n                  </CardContent>\r\n                </Card>\r\n              </Grid>\r\n            </Grid>\r\n          )}\r\n        </DialogContent>\r\n        <DialogActions>\r\n          <Button onClick={() => setShowStatsDialog(false)}>Kapat</Button>\r\n        </DialogActions>\r\n      </Dialog>\r\n    </Container>\r\n  );\r\n}\r\n\r\nexport default BionicReadingPage;\r\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\f