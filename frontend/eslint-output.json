          inputProps={{ min: 2, max: 100 }}\r\n              fullWidth\r\n            />\r\n          </Box>\r\n        </DialogContent>\r\n        <DialogActions>\r\n          <Button onClick={() => setCreateDialogOpen(false)}>İptal</Button>\r\n          <Button onClick={handleCreateRoom} variant=\"contained\" disabled={!newRoom.name}>\r\n            Oluştur\r\n          </Button>\r\n        </DialogActions>\r\n      </Dialog>\r\n    </Box>\r\n  );\r\n};\r\n\r\nexport default StudyRoomList;\r\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\frontend\\src\\components\\StudyRooms\\StudyRoomView.tsx","messages":[{"ruleId":"import/no-named-as-default","severity":1,"message":"Using exported name 'VideoConference' as identifier for default import.","line":40,"column":8,"nodeType":"ImportDefaultSpecifier","endLine":40,"endColumn":23},{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: Cannot access variable before it is declared\n\n`fetchRoomDetails` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Users\\husey\\kiro2\\frontend\\src\\components\\StudyRooms\\StudyRoomView.tsx:97:5\n   95 |\n   96 |   useEffect(() => {\n>  97 |     fetchRoomDetails();\n      |     ^^^^^^^^^^^^^^^^ `fetchRoomDetails` accessed before it is declared\n   98 |     fetchMembers();\n   99 |   }, [roomId]);\n  100 |\n\nC:\\Users\\husey\\kiro2\\frontend\\src\\components\\StudyRooms\\StudyRoomView.tsx:101:3\n   99 |   }, [roomId]);\n  100 |\n> 101 |   const fetchRoomDetails = async () => {\