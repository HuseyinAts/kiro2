lace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":31,"column":66,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[650,750],"text":"\r\n          Henüz öğrenme yolu oluşturulmamış. Lütfen \"Yol Haritası&quot; sekmesinden başlayın.\r\n        "},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[650,750],"text":"\r\n          Henüz öğrenme yolu oluşturulmamış. Lütfen \"Yol Haritası&ldquo; sekmesinden başlayın.\r\n        "},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[650,750],"text":"\r\n          Henüz öğrenme yolu oluşturulmamış. Lütfen \"Yol Haritası&#34; sekmesinden başlayın.\r\n        "},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[650,750],"text":"\r\n          Henüz öğrenme yolu oluşturulmamış. Lütfen \"Yol Haritası&rdquo; sekmesinden başlayın.\r\n        "},"desc":"Replace with `&rdquo;`."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * PathProgressTab Component\r\n * Progress tracking tab for learning path\r\n */\r\n\r\nimport {\r\n  Box,\r\n  Typography,\r\n  Paper,\r\n  Chip,\r\n  Alert,\r\n  CircularProgress,\r\n} from '@mui/material';\r\nimport * as React from 'react';\n\r\nimport learningPathService from '../../services/learningPathService';\n\r\nimport { PathNodeData } from './PathNode';\n\r\ninterface PathProgressTabProps {\r\n  pathNodes: PathNodeData[];\r\n}\r\n\r\nexport const PathProgressTab: React.FC<PathProgressTabProps> = ({ pathNodes }) => {\r\n  const hasPath = learningPathService.getCurrentPath();\r\n\r\n  if (!hasPath) {\r\n    return (\r\n      <Box sx={{ px: 2 }}>\r\n        <Alert severity=\"info\">\r\n          Henüz öğrenme yolu oluşturulmamış. Lütfen \"Yol Haritası\" sekmesinden başlayın.\r\n        </Alert>\r\n      </Box>\r\n    );\r\n  }\r\n\r\n  const completedCount = pathNodes.filter(n => n.status === 'completed').length;\r\n  const currentCount = pathNodes.filter(n => n.status === 'current').length;\r\n  const availableCount = pathNodes.filter(n => n.status === 'available').length;\r\n  const completionPercentage = pathNodes.length > 0 ? (completedCount / pathNodes.length) * 100 : 0;\r\n\r\n  const totalDuration = pathNodes.reduce((sum, node) => {\r\n    const match = node.estimatedTime?.match(/(\\d+)/);\r\n    return sum + (match ? parseInt(match[1]) : 0);\r\n  }, 0);\r\n\r\n  const moduleTitles = ['Temel Kavramlar', 'Orta Seviye', 'İleri Seviye'];\r\n\r\n  return (\r\n    <Box sx={{ px: 2 }}>\r\n      <Typography variant=\"h5\" fontWeight=\"bold\" gutterBottom>\r\n        📊 İlerleme Takibi\r\n      </Typography>\r\n\r\n      {/* Overall Progress Card */}\r\n      <Paper\r\n        elevation={2}\r\n        sx={{\r\n          p: 3,\r\n          mb: 3,\r\n          background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',\r\n          color: 'white',\r\n        }}\r\n      >\r\n        <Box className=\"flex items-center justify-between mb-2\">\r\n          <Typography variant=\"h6\" fontWeight=\"bold\">\r\n            Genel İlerlemeniz\r\n          </Typography>\r\n          <Chip\r\n            label={`${Math.round(completionPercentage)}%`}\r\n            sx={{\r\n              backgroundColor: 'rgba(255,255,255,0.3)',\r\n              color: 'white',\r\n              fontWeight: 'bold',\r\n              fontSize: '1rem',\r\n            }}\r\n          />\r\n        </Box>\r\n\r\n        <Box sx={{ mt: 2, mb: 1 }}>\r\n          <Box className=\"flex justify-between mb-1\">\r\n            <Typography variant=\"body2\">\r\n              {completedCount} / {pathNodes.length} Konu Tamamlandı\r\n            </Typography>\r\n            <Typography variant=\"body2\">{currentCount} Devam Ediyor</Typography>\r\n          </Box>\r\n          <Box\r\n            sx={{\r\n              width: '100%',\r\n              height: 12,\r\n              backgroundColor: 'rgba(255,255,255,0.3)',\r\n              borderRadius: 2,\r\n              overflow: 'hidden',\r\n            }}\r\n          >\r\n            <Box\r\n              sx={{\r\n                width: `${completionPercentage}%`,\r\n                height: '100%',\r\n                backgroundColor: 'white',\r\n                transition: 'width 0.5s ease',\r\n              }}\r\n            />\r\n          </Box>\r\n        </Box>\r\n\r\n        <Box className=\"flex gap-4 mt-3\">\r\n          <Box>\r\n            <Typography variant=\"caption\" sx={{ opacity: 0.8 }}>\r\n              Toplam Modül\r\n            </Typography>\r\n            <Typography variant=\"h5\" fontWeight=\"bold\">\r\n              3\r\n            </Typography>\r\n          </Box>\r\n          <Box>\r\n            <Typography variant=\"caption\" sx={{ opacity: 0.8 }}>\r\n              Toplam Konu\r\n            </Typography>\r\n            <Typography variant=\"h5\" fontWeight=\"bold\">\r\n              {pathNodes.length}\r\n            </Typography>\r\n          </Box>\r\n          <Box>\r\n            <Typography variant=\"caption\" sx={{ opacity: 0.8 }}>\r\n              Tahmini Süre\r\n            </Typography>\r\n            <Typography variant=\"h5\" fontWeight=\"bold\">\r\n              {totalDuration} dk\r\n            </Typography>\r\n          </Box>\r\n        </Box>\r\n      </Paper>\r\n\r\n      {/* Module Progress */}\r\n      <Typography variant=\"h6\" fontWeight=\"bold\" gutterBottom sx={{ mt: 4 }}>\r\n        Modül Bazında İlerleme\r\n      </Typography>\r\n\r\n      {Array.from({ length: 3 }, (_, moduleIndex) => {\r\n        const moduleId = `MOD${moduleIndex + 1}`;\r\n        const moduleNodes = pathNodes.filter((node) => node.id.startsWith(moduleId));\r\n        const completedInModule = moduleNodes.filter((n) => n.status === 'completed').length;\r\n        const moduleProgress = moduleNodes.length > 0 ? (completedInModule / moduleNodes.length) * 100 : 0;\r\n\r\n        return (\r\n          <Paper key={moduleId} elevation={1} sx={{ p: 3, mb: 2 }}>\r\n            <Box className=\"flex items-center justify-between mb-2\">\r\n              <Box>\r\n                <Typography variant=\"h6\" fontWeight=\"bold\">\r\n                  Modül {moduleIndex + 1}: {moduleTitles[moduleIndex]}\r\n                </Typography>\r\n                <Typography variant=\"body2\" color=\"text.secondary\">\r\n                  {completedInModule} / {moduleNodes.length} Konu Tamamlandı\r\n                </Typography>\r\n              </Box>\r\n              <Chip\r\n                label={`${Math.round(moduleProgress)}%`}\r\n                color={moduleProgress === 100 ? 'success' : moduleProgress > 0 ? 'primary' : 'default'}\r\n                sx={{ fontWeight: 'bold' }}\r\n              />\r\n            </Box>\r\n\r\n            <Box\r\n              sx={{\r\n                width: '100%',\r\n                height: 8,\r\n                backgroundColor: 'rgba(0,0,0,0.1)',\r\n                borderRadius: 2,\r\n                overflow: 'hidden',\r\n                mb: 2,\r\n              }}\r\n            >\r\n              <Box\r\n                sx={{\r\n                  width: `${moduleProgress}%`,\r\n                  height: '100%',\r\n                  backgroundColor: moduleProgress === 100 ? '#4caf50' : '#2196f3',\r\n                  transition: 'width 0.5s ease',\r\n                }}\r\n              />\r\n            </Box>\r\n\r\n            {/* Topic List */}\r\n            <Box className=\"flex flex-col gap-2\">\r\n              {moduleNodes.map((node) => (\r\n                <Box\r\n                  key={node.id}\r\n                  className=\"flex items-center justify-between p-2 rounded\"\r\n                  sx={{\r\n                    backgroundColor:\r\n                      node.status === 'completed'\r\n                        ? 'rgba(76, 175, 80, 0.1)'\r\n                        : node.status === 'current'\r\n                        ? 'rgba(33, 150, 243, 0.1)'\r\n                        : 'rgba(0,0,0,0.02)',\r\n                    border: '1px solid',\r\n                    borderColor:\r\n                      node.status === 'completed'\r\n                        ? 'success.light'\r\n                        : node.status === 'current'\r\n                        ? 'primary.light'\r\n                        : 'divider',\r\n                  }}\r\n                >\r\n                  <Box className=\"flex items-center gap-2\">\r\n                    {node.status === 'completed' ? (\r\n                      <Box sx={{ color: 'success.main' }}>✓</Box>\r\n                    ) : node.status === 'current' ? (\r\n                      <CircularProgress size={20} thickness={5} />\r\n                    ) : (\r\n                      <Box sx={{ color: 'text.disabled' }}>○</Box>\r\n                    )}\r\n                    <Box>\r\n                      <Typography variant=\"body2\" fontWeight={node.status === 'current' ? 'bold' : 'normal'}>\r\n                        {node.title}\r\n                      </Typography>\r\n                      <Typography variant=\"caption\" color=\"text.secondary\">\r\n                        {node.estimatedTime}\r\n                      </Typography>\r\n                    </Box>\r\n                  </Box>\r\n                  <Box className=\"flex items-center gap-2\">\r\n                    {node.status === 'completed' && <Chip label=\"Tamamlandı\" size=\"small\" color=\"success\" />}\r\n                    {node.status === 'current' && <Chip label={`${node.progress}%`} size=\"small\" color=\"primary\" />}\r\n                    {(node.resources ?? 0) > 0 && <Chip label={`${node.resources} Kaynak`} size=\"small\" variant=\"outlined\" />}\r\n                  </Box>\r\n                </Box>\r\n              ))}\r\n            </Box>\r\n          </Paper>\r\n        );\r\n      })}\r\n\r\n      {/* Detailed Statistics */}\r\n      <Paper elevation={2} sx={{ p: 3, mt: 3, backgroundColor: '#f5f5f5' }}>\r\n        <Typography variant=\"h6\" fontWeight=\"bold\" gutterBottom>\r\n          📈 Detaylı İstatistikler\r\n        </Typography>\r\n        <Box className=\"grid grid-cols-2 md:grid-cols-4 gap-4 mt-3\">\r\n          <Box sx={{ textAlign: 'center' }}>\r\n            <Typography variant=\"h4\" color=\"success.main\" fontWeight=\"bold\">\r\n              {completedCount}\r\n            </Typography>\r\n            <Typography variant=\"caption\" color=\"text.secondary\">\r\n              Tamamlanan Konular\r\n            </Typography>\r\n          </Box>\r\n          <Box sx={{ textAlign: 'center' }}>\r\n            <Typography variant=\"h4\" color=\"primary.main\" fontWeight=\"bold\">\r\n              {currentCount}\r\n            </Typography>\r\n            <Typography variant=\"caption\" color=\"text.secondary\">\r\n              Devam Eden\r\n            </Typography>\r\n          </Box>\r\n          <Box sx={{ textAlign: 'center' }}>\r\n            <Typography variant=\"h4\" color=\"text.secondary\" fontWeight=\"bold\">\r\n              {availableCount}\r\n            </Typography>\r\n            <Typography variant=\"caption\" color=\"text.secondary\">\r\n              Bekleyen\r\n            </Typography>\r\n          </Box>\r\n          <Box sx={{ textAlign: 'center' }}>\r\n            <Typography variant=\"h4\" color=\"warning.main\" fontWeight=\"bold\">\r\n              {Math.round(completionPercentage)}%\r\n            </Typography>\r\n            <Typography variant=\"caption\" color=\"text.secondary\">\r\n              Tamamlanma Oranı\r\n            </Typography>\r\n          </Box>\r\n        </Box>\r\n      </Paper>\r\n    </Box>\r\n  );\r\n};\r\n\r\nexport defa