sh text simplification system\r\n *\r\n * Features:\r\n * - Level 1: Lexical (Word-level simplification)\r\n * - Level 2: Syntactic (Sentence structure simplification)\r\n * - Level 3: Semantic (Meaning-level simplification)\r\n * - Complex word detection\r\n * - Flesch-Kincaid readability scoring\r\n * - Real-time analysis\r\n */\r\nimport {\r\n  AutoFixHigh,\r\n  Psychology,\r\n  Assessment,\r\n  ContentCopy,\r\n  Info,\r\n  CheckCircle,\r\n  Warning,\r\n  Error as ErrorIcon,\r\n  Lightbulb,\r\n  CompareArrows,\r\n  TextFields,\r\n  MenuBook,\r\n  Analytics,\r\n} from '@mui/icons-material';\r\nimport {\r\n  Container,\r\n  Paper,\r\n  Typography,\r\n  Box,\r\n  Grid,\r\n  Card,\r\n  CardContent,\r\n  Button,\r\n  TextField,\r\n  Alert,\r\n  CircularProgress,\r\n  Chip,\r\n  Divider,\r\n  Tabs,\r\n  Tab,\r\n  Slider,\r\n  FormControlLabel,\r\n  Switch,\r\n  IconButton,\r\n  LinearProgress,\r\n  Table,\r\n  TableBody,\r\n  TableCell,\r\n  TableContainer,\r\n  TableHead,\r\n  TableRow,\r\n  List,\r\n  ListItem,\r\n  ListItemIcon,\r\n  ListItemText,\r\n} from '@mui/material';\r\nimport { useState } from 'react';\r\n\r\ninterface ComplexWord {\r\n  word: string;\r\n  complexity_score: number;\r\n  frequency_score: number;\r\n  position: number;\r\n  suggested_replacements: string[];\r\n}\r\n\r\ninterface SimplificationResult {\r\n  original_text: string;\r\n  simplified_text: string;\r\n  statistics: {\r\n    complex_words_replaced: number;\r\n    sentences_split: number;\r\n    readability_improvement: number;\r\n    original_flesch_score: number;\r\n    simplified_flesch_score: number;\r\n  };\r\n  suggestions: string[];\r\n  improvement_percentage: number;\r\n}\r\n\r\ninterface FleschResult {\r\n  flesch_reading_ease: number;\r\n  flesch_kincaid_grade: number;\r\n  grade_level: string;\r\n  difficulty: string;\r\n  statistics: {\r\n    total_words: number;\r\n    total_sentences: number;\r\n    total_syllables: number;\r\n    avg_words_per_sentence: number;\r\n    avg_syllables_per_word: number;\r\n  };\r\n  interpretation: {\r\n    score_range: string;\r\n    target_audience: string;\r\n    recommendations: string[];\r\n  };\r\n}\r\n\r\nexport function TextSimplificationPage() {\r\n  const [activeTab, setActiveTab] = useState(0);\r\n  const [inputText, setInputText] = useState('');\r\n  const [loading, setLoading] = useState(false);\r\n  const [error, setError] = useState<string | null>(null);\r\n\r\n  // Complex Words Detection\r\n  const [complexWords, setComplexWords] = useState<ComplexWord[]>([]);\r\n  const [complexityThreshold, setComplexityThreshold] = useState(0.6);\r\n\r\n  // Text Simplification\r\n  const [simplificationResult, setSimplificationResult] = useState<SimplificationResult | null>(null);\r\n  const [maxSentenceLength, setMaxSentenceLength] = useState(20);\r\n  const [replaceSynonyms, setReplaceSynonyms] = useState(true);\r\n  const [splitSentences, setSplitSentences] = useState(true);\r\n\r\n  // Flesch Score\r\n  const [fleschResult, setFleschResult] = useState<FleschResult | null>(null);\r\n\r\n  const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:8001';\r\n  const token = localStorage.getItem('token');\r\n\r\n  // Sample texts for demo\r\n  const sampleTexts = {\r\n    simple: 'Bugün hava çok güzel. Okula gitmek istiyorum. Matematik dersini seviyorum.',\r\n    medium: 'Teknolojinin implementasyonu, organizasyonun performansını optimize etmek için kritik bir faktördür. Müessesemizin teşebbüsü, müşterilerimizin muvaffakiyetini sağlamaktır.',\r\n    complex: 'Medeniyetimizin mütalaa ve tetkik edilen münasebet ve müzakere süreçlerinde, istifade edilen metodoloji ve algoritmaların optimizasyonu, müesseselerimizin muvaffakiyeti için elzemdir.',\r\n  };\r\n\r\n  const handleDetectComplexWords = async () => {\r\n    if (!inputText.trim()) {\r\n      setError('Lütfen metin girin');\r\n      return;\r\n    }\r\n\r\n    try {\r\n      setLoading(true);\r\n      setError(null);\r\n\r\n      const response = await fetch(`${API_URL}/api/v1/text-simplification/detect-complex-words`, {\r\n        method: 'POST',\r\n        headers: {\r\n          'Authorization': `Bearer ${token}`,\r\n          'Content-Type': 'application/json',\r\n        },\r\n        body: JSON.stringify({\r\n          text: inputText,\r\n          complexity_threshold: complexityThreshold,\r\n        }),\r\n      });\r\n\r\n      if (!response.ok) {\r\n        throw new Error('Karmaşık kelime tespiti başarısız oldu');\r\n      }\r\n\r\n      const data = await response.json();\r\n      setComplexWords(data.data.complex_words || []);\r\n    } catch (err: any) {\r\n      console.error('Complex word detection error:', err);\r\n      setError(err.message || 'Hata oluştu');\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  const handleSimplifyText = async () => {\r\n    if (!inputText.trim()) {\r\n      setError('Lütfen metin girin');\r\n      return;\r\n    }\r\n\r\n    try {\r\n      setLoading(true);\r\n      setError(null);\r\n\r\n      const response = await fetch(`${API_URL}/api/v1/text-simplification/simplify`, {\r\n        method: 'POST',\r\n        headers: {\r\n          'Authorization': `Bearer ${token}`,\r\n          'Content-Type': 'application/json',\r\n        },\r\n        body: JSON.stringify({\r\n          text: inputText,\r\n          complexity_threshold: complexityThreshold,\r\n          max_sentence_length: maxSentenceLength,\r\n          replace_synonyms: replaceSynonyms,\r\n          split_sentences: splitSentences,\r\n          require_confirmation: false,\r\n        }),\r\n      });\r\n\r\n      if (!response.ok) {\r\n        throw new Error('Metin basitleştirme başarısız oldu');\r\n      }\r\n\r\n      const data = await response.json();\r\n      setSimplificationResult(data.data);\r\n    } catch (err: any) {\r\n      console.error('Text simplification error:', err);\r\n      setError(err.message || 'Hata oluştu');\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  const handleCalculateFleschScore = async () => {\r\n    if (!inputText.trim()) {\r\n      setError('Lütfen metin girin');\r\n      return;\r\n    }\r\n\r\n    try {\r\n      setLoading(true);\r\n      setError(null);\r\n\r\n      const response = await fetch(`${API_URL}/api/v1/text-simplification/flesch-score`, {\r\n        method: 'POST',\r\n        headers: {\r\n          'Authorization': `Bearer ${token}`,\r\n          'Content-Type': 'application/json',\r\n        },\r\n        body: JSON.stringify({\r\n          text: inputText,\r\n        }),\r\n      });\r\n\r\n      if (!response.ok) {\r\n        throw new Error('Okunabilirlik skoru hesaplanamadı');\r\n      }\r\n\r\n      const data = await response.json();\r\n      setFleschResult(data.data);\r\n    } catch (err: any) {\r\n      console.error('Flesch score calculation error:', err);\r\n      setError(err.message || 'Hata oluştu');\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  const handleCopyToClipboard = (text: string) => {\r\n    navigator.clipboard.writeText(text);\r\n    alert('📋 Metín panoya kopyalandı!');\r\n  };\r\n\r\n  const getScoreColor = (score: number): string => {\r\n    if (score >= 80) {return 'success.main';}\r\n    if (score >= 60) {return 'info.main';}\r\n    if (score >= 40) {return 'warning.main';}\r\n    return 'error.main';\r\n  };\r\n\r\n  const getDifficultyIcon = (difficulty: string) => {\r\n    if (difficulty.includes('Kolay')) {return <CheckCircle color=\"success\" />;}\r\n    if (difficulty.includes('Standart')) {return <Info color=\"info\" />;}\r\n    if (difficulty.includes('Zor')) {return <Warning color=\"warning\" />;}\r\n    return <ErrorIcon color=\"error\" />;\r\n  };\r\n\r\n  return (\r\n    <Container maxWidth=\"xl\" sx={{ py: 4 }}>\r\n      {/* Header */}\r\n      <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', mb: 4 }}>\r\n        <Box sx={{ display: 'flex', alignItems: 'center' }}>\r\n          <AutoFixHigh sx={{ fontSize: 40, color: 'primary.main', mr: 2 }} />\r\n          <Box>\r\n            <Typography variant=\"h4\" fontWeight=\"bold\">\r\n              Türkçe Metin Basitleştirme\r\n            </Typography>\r\n            <Typography variant=\"body2\" color=\"text.secondary\">\r\n              3 Seviyeli Akıllı Basitleştirme Sistemi • Disleksi Desteği\r\n            </Typography>\r\n          </Box>\r\n        </Box>\r\n\r\n        <Box sx={{ display: 'flex', gap: 2 }}>\r\n          <Button\r\n            variant=\"outlined\"\r\n            onClick={() => setInputText(sampleTexts.simple)}\r\n          >\r\n            Basit Örnek\r\n          </Button>\r\n          <Button\r\n            variant=\"outlined\"\r\n            onClick={() => setInputText(sampleTexts.medium)}\r\n          >\r\n            Orta Örnek\r\n          </Button>\r\n          <Button\r\n            variant=\"outlined\"\r\n            onClick={() => setInputText(sampleTexts.complex)}\r\n          >\r\n            Karmaşık Örnek\r\n          </Button>\r\n        </Box>\r\n      </Box>\r\n\r\n      {error && (\r\n        <Alert severity=\"error\" sx={{ mb: 3 }} onClose={() => setError(null)}>\r\n          {error}\r\n        </Alert>\r\n      )}\r\n\r\n      {/* Info Banner */}\r\n      <Alert severity=\"info\" icon={<Lightbulb />} sx={{ mb: 3 }}>\r\n        <Typography variant=\"body2\" fontWeight=\"bold\">\r\n          🌟 Dünyada İlk 3 Seviyeli Türkçe Metin Basitleştirme Sistemi\r\n        </Typography>\r\n        <Typography variant=\"caption\">\r\n          Seviye 1: Kelime (Osmanlıca/Akademik → Günlük) |\r\n          Seviye 2: Cümle Yapısı |\r\n          Seviye 3: Anlam Basitleştirme\r\n        </Typography>\r\n      </Alert>\r\n\r\n      <Grid container spacing={3}>\r\n        {/* Input Section */}\r\n        <Grid item xs={12} md={6}>\r\n          <Paper elevation={2} sx={{ p: 3, height: '100%' }}>\r\n            <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', mb: 2 }}>\r\n              <Typography variant=\"h6\" sx={{ display: 'flex', alignItems: 'center' }}>\r\n                <TextFields sx={{ mr: 1 }} />\r\n                Giriş Metni\r\n              </Typography>\r\n              <Chip\r\n                label={`${inputText.length} karakter`}\r\n                size=\"small\"\r\n                color={inputText.length > 5000 ? 'error' : 'default'}\r\n              />\r\n            </Box>\r\n\r\n            <TextField\r\n              multiline\r\n              rows={12}\r\n              fullWidth\r\n              placeholder=\"Basitleştirilecek metni buraya yazın...\"\r\n              value={inputText}\r\n              onChange={(e) => setInputText(e.target.value)}\r\n              sx={{ mb: 2 }}\r\n            />\r\n\r\n            <Box sx={{ mb: 2 }}>\r\n              <Typography variant=\"body2\" gutterBottom>\r\n                Karmaşıklık Eşiği: {(complexityThreshold * 100).toFixed(0)}%\r\n              </Typography>\r\n              <Slider\r\n                value={complexityThreshold}\r\n                onChange={(_, value) => setComplexityThreshold(value as number)}\r\n                min={0}\r\n                max={1}\r\n                step={0.1}\r\n                marks\r\n                valueLabelDisplay=\"auto\"\r\n                valueLabelFormat={(value) => `${(value * 100).toFixed(0)}%`}\r\n              />\r\n            </Box>\r\n\r\n            <Box sx={{ mb: 2 }}>\r\n              <Typography variant=\"body2\" gutterBottom>\r\n                Maksimum Cümle Uzunluğu: {maxSentenceLength} kelime\r\n              </Typography>\r\n              <Slider\r\n                value={maxSentenceLength}\r\n                onChange={(_, value) => setMaxSentenceLength(value as number)}\r\n                min={10}\r\n                max={40}\r\n                step={5}\r\n                marks\r\n                valueLabelDisplay=\"auto\"\r\n              />\r\n            </Box>\r\n\r\n            <Box sx={{ display: 'flex', gap: 2, mb: 2 }}>\r\n              <FormControlLabel\r\n                control={\r\n                  <Switch\r\n                    checked={replaceSynonyms}\r\n                    onChange={(e) => setReplaceSynonyms(e.target.checked)}\r\n                  />\r\n                }\r\n                label=\"Eşanlamlı Değiştir\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Switch\r\n                    checked={splitSentences}\r\n                    onChange={(e) => setSplitSentences(e.target.checked)}\r\n                  />\r\n                }\r\n                label=\"Cümle Böl\"\r\n              />\r\n            </Box>\r\n\r\n            <Grid container spacing={2}>\r\n              <Grid item xs={12} md={4}>\r\n                <Button\r\n                  variant=\"contained\"\r\n                  fullWidth\r\n                  startIcon={loading ? <CircularProgress size={20} /> : <Psychology />}\r\n                  onClick={handleDetectComplexWords}\r\n                  disabled={loading || !inputText.trim()}\r\n                >\r\n                  Karmaşık Kelimeler\r\n                </Button>\r\n              </Grid>\r\n              <Grid item xs={12} md={4}>\r\n                <Button\r\n                  variant=\"contained\"\r\n                  fullWidth\r\n                  color=\"secondary\"\r\n                  startIcon={loading ? <CircularProgress size={20} /> : <AutoFixHigh />}\r\n                  onClick={handleSimplifyText}\r\n                  disabled={loading || !inputText.trim()}\r\n                >\r\n                  Basitleştir\r\n                </Button>\r\n              </Grid>\r\n              <Grid item xs={12} md={4}>\r\n                <Button\r\n                  variant=\"contained\"\r\n                  fullWidth\r\n                  color=\"info\"\r\n                  startIcon={loading ? <CircularProgress size={20} /> : <Assessment />}\r\n                  onClick={handleCalculateFleschScore}\r\n                  disabled={loading || !inputText.trim()}\r\n                >\r\n                  Okunabilirlik\r\n                </Button>\r\n              </Grid>\r\n            </Grid>\r\n          </Paper>\r\n        </Grid>\r\n\r\n        {/* Results Section */}\r\n        <Grid item xs={12} md={6}>\r\n          <Paper elevation={2} sx={{ p: 3, height: '100%' }}>\r\n            <Tabs value={activeTab} onChange={(_, v) => setActiveTab(v)} sx={{ mb: 2 }}>\r\n              <Tab icon={<Psychology />} label=\"Karmaşık Kelimeler\" />\r\n              <Tab icon={<AutoFixHigh />} label=\"Basitleştirilmiş\" />\r\n              <Tab icon={<Assessment />} label=\"Okunabilirlik\" />\r\n            </Tabs>\r\n\r\n            {/* Complex Words Tab */}\r\n            {activeTab === 0 && (\r\n              <Box>\r\n                {complexWords.length > 0 ? (\r\n                  <>\r\n                    <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', mb: 2 }}>\r\n                      <Typography variant=\"h6\">\r\n                        {complexWords.length} Karmaşık Kelime Bulundu\r\n                      </Typography>\r\n                      <Chip\r\n                        label={`Ortalama Karmaşıklık: ${(complexWords.reduce((sum, w) => sum + w.complexity_score, 0) / complexWords.length * 100).toFixed(0)}%`}\r\n                        color=\"warning\"\r\n                      />\r\n                    </Box>\r\n\r\n                    <TableContainer sx={{ maxHeight: 400 }}>\r\n                      <Table size=\"small\" stickyHeader>\r\n                        <TableHead>\r\n                          <TableRow>\r\n                            <TableCell>Kelime</TableCell>\r\n                            <TableCell>Karmaşıklık</TableCell>\r\n                            <TableCell>Öneriler</TableCell>\r\n                          </TableRow>\r\n                        </TableHead>\r\n                        <TableBody>\r\n                          {complexWords.map((word, idx) => (\r\n                            <TableRow key={idx}>\r\n                              <TableCell>\r\n                                <Typography fontWeight=\"bold\">\r\n                                  {word.word}\r\n                                </Typography>\r\n                              </TableCell>\r\n                              <TableCell>\r\n                                <LinearProgress\r\n                                  variant=\"determinate\"\r\n                                  value={word.complexity_score * 100}\r\n                                  sx={{\r\n                                    width: 80,\r\n                                    mr: 1,\r\n                                    '& .MuiLinearProgress-bar': {\r\n                                      backgroundColor: word.complexity_score > 0.7 ? 'error.main' : 'warning.main',\r\n                                    },\r\n                                  }}\r\n                                />\r\n                                <Typography variant=\"caption\">\r\n                                  {(word.complexity_score * 100).toFixed(0)}%\r\n                                </Typography>\r\n                              </TableCell>\r\n                              <TableCell>\r\n                                <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 0.5 }}>\r\n                                  {word.suggested_replacements.slice(0, 3).map((replacement, ridx) => (\r\n                                    <Chip\r\n                                      key={ridx}\r\n                                      label={replacement}\r\n                                      size=\"small\"\r\n                                      color=\"success\"\r\n                                      variant=\"outlined\"\r\n                                    />\r\n                                  ))}\r\n                                </Box>\r\n                              </TableCell>\r\n                            </TableRow>\r\n                          ))}\r\n                        </TableBody>\r\n                      </Table>\r\n                    </TableContainer>\r\n                  </>\r\n                ) : (\r\n                  <Box sx={{ textAlign: 'center', py: 8 }}>\r\n                    <Psychology sx={{ fontSize: 60, color: 'text.secondary', mb: 2 }} />\r\n                    <Typography variant=\"h6\" color=\"text.secondary\">\r\n                      Karmaşık kelime analizi yapmak için \"Karmaşık Kelimeler\" butonuna tıklayın\r\n                    </Typography>\r\n                  </Box>\r\n                )}\r\n              </Box>\r\n            )}\r\n\r\n            {/* Simplified Text Tab */}\r\n            {activeTab === 1 && (\r\n              <Box>\r\n                {simplificationResult ? (\r\n                  <>\r\n                    <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', mb: 2 }}>\r\n                      <Typography variant=\"h6\">Basitleştirilmiş Metin</Typography>\r\n                      <IconButton onClick={() => handleCopyToClipboard(simplificationResult.simplified_text)}>\r\n                        <ContentCopy />\r\n                      </IconButton>\r\n                    </Box>\r\n\r\n                    {/* Statistics */}\r\n                    <Grid container spacing={2} sx={{ mb: 3 }}>\r\n                      <Grid item xs={6}>\r\n                        <Card elevation={1}>\r\n                          <CardContent sx={{ textAlign: 'center', py: 1.5 }}>\r\n                            <Typography variant=\"h4\" color=\"primary\">\r\n                              {simplificationResult.statistics.complex_words_replaced}\r\n                            </Typography>\r\n                            <Typography variant=\"caption\">Değiştirilen Kelime</Typography>\r\n                          </CardContent>\r\n                        </Card>\r\n                      </Grid>\r\n                      <Grid item xs={6}>\r\n                        <Card elevation={1}>\r\n                          <CardContent sx={{ textAlign: 'center', py: 1.5 }}>\r\n                            <Typography variant=\"h4\" color=\"secondary\">\r\n                              {simplificationResult.statistics.sentences_split}\r\n                            </Typography>\r\n                            <Typography variant=\"caption\">Bölünen Cümle</Typography>\r\n                          </CardContent>\r\n                        </Card>\r\n                      </Grid>\r\n                      <Grid item xs={6}>\r\n                        <Card elevation={1}>\r\n                          <CardContent sx={{ textAlign: 'center', py: 1.5 }}>\r\n                            <Typography variant=\"h4\" color=\"success.main\">\r\n                              +{simplificationResult.statistics.readability_improvement.toFixed(1)}\r\n                            </Typography>\r\n                            <Typography variant=\"caption\">Okunabilirlik İyileşmesi</Typography>\r\n                          </CardContent>\r\n                        </Card>\r\n                      </Grid>\r\n                      <Grid item xs={6}>\r\n                        <Card elevation={1}>\r\n                          <CardContent sx={{ textAlign: 'center', py: 1.5 }}>\r\n                            <Typography variant=\"h4\" color=\"info.main\">\r\n                              {simplificationResult.improvement_percentage.toFixed(0)}%\r\n                            </Typography>\r\n                            <Typography variant=\"caption\">İyileşme Oranı</Typography>\r\n                          </CardContent>\r\n                        </Card>\r\n                      </Grid>\r\n                    </Grid>\r\n\r\n                    <Paper sx={{ p: 2, mb: 2, backgroundColor: 'success.light', color: 'white' }}>\r\n                      <Typography variant=\"body1\" sx={{ whiteSpace: 'pre-wrap' }}>\r\n                        {simplificationResult.simplified_text}\r\n                      </Typography>\r\n                    </Paper>\r\n\r\n                    {simplificationResult.suggestions.length > 0 && (\r\n                      <Box>\r\n                        <Typography variant=\"subtitle2\" gutterBottom>\r\n                          💡 Öneriler:\r\n                        </Typography>\r\n                        <List dense>\r\n                          {simplificationResult.suggestions.map((suggestion, idx) => (\r\n                            <ListItem key={idx}>\r\n                              <ListItemIcon>\r\n                                <Lightbulb fontSize=\"small\" color=\"warning\" />\r\n                              </ListItemIcon>\r\n                              <ListItemText primary={suggestion} />\r\n                            </ListItem>\r\n                          ))}\r\n                        </List>\r\n                      </Box>\r\n                    )}\r\n                  </>\r\n                ) : (\r\n                  <Box sx={{ textAlign: 'center', py: 8 }}>\r\n                    <AutoFixHigh sx={{ fontSize: 60, color: 'text.secondary', mb: 2 }} />\r\n                    <Typography variant=\"h6\" color=\"text.secondary\">\r\n                      Metin basitleştirmek için \"Basitleştir\" butonuna tıklayın\r\n                    </Typography>\r\n                  </Box>\r\n                )}\r\n              </Box>\r\n            )}\r\n\r\n            {/* Flesch Score Tab */}\r\n            {activeTab === 2 && (\r\n              <Box>\r\n                {fleschResult ? (\r\n                  <>\r\n                    <Box sx={{ textAlign: 'center', mb: 3 }}>\r\n                      <Typography variant=\"h3\" sx={{ color: getScoreColor(fleschResult.flesch_reading_ease) }}>\r\n                        {fleschResult.flesch_reading_ease.toFixed(1)}\r\n                      </Typography>\r\n                      <Typography variant=\"h6\" color=\"text.secondary\">\r\n                        Flesch Reading Ease\r\n                      </Typography>\r\n                      <Chip\r\n                        label={fleschResult.difficulty}\r\n                        icon={getDifficultyIcon(fleschResult.difficulty)}\r\n                        sx={{ mt: 1 }}\r\n                      />\r\n                    </Box>\r\n\r\n                    <Divider sx={{ my: 2 }} />\r\n\r\n                    {/* Statistics Grid */}\r\n                    <Grid container spacing={2} sx={{ mb: 3 }}>\r\n                      <Grid item xs={6}>\r\n                        <Card elevation={1}>\r\n                          <CardContent sx={{ textAlign: 'center', py: 1.5 }}>\r\n                            <Typography variant=\"h5\">\r\n                              {fleschResult.statistics.total_words}\r\n                            </Typography>\r\n                            <Typography variant=\"caption\">Toplam Kelime</Typography>\r\n                          </CardContent>\r\n                        </Card>\r\n                      </Grid>\r\n                      <Grid item xs={6}>\r\n                        <Card elevation={1}>\r\n                          <CardContent sx={{ textAlign: 'center', py: 1.5 }}>\r\n                            <Typography variant=\"h5\">\r\n                              {fleschResult.statistics.total_sentences}\r\n                            </Typography>\r\n                            <Typography variant=\"caption\">Toplam Cümle</Typography>\r\n                          </CardContent>\r\n                        </Card>\r\n                      </Grid>\r\n                      <Grid item xs={6}>\r\n                        <Card elevation={1}>\r\n                          <CardContent sx={{ textAlign: 'center', py: 1.5 }}>\r\n                            <Typography variant=\"h5\">\r\n                              {fleschResult.statistics.avg_words_per_sentence.toFixed(1)}\r\n                            </Typography>\r\n                            <Typography variant=\"caption\">Ort. Kelime/Cümle</Typography>\r\n                          </CardContent>\r\n                        </Card>\r\n                      </Grid>\r\n                      <Grid item xs={6}>\r\n                        <Card elevation={1}>\r\n                          <CardContent sx={{ textAlign: 'center', py: 1.5 }}>\r\n                            <Typography variant=\"h5\">\r\n                              {fleschResult.statistics.avg_syllables_per_word.toFixed(1)}\r\n                            </Typography>\r\n                            <Typography variant=\"caption\">Ort. Hece/Kelime</Typography>\r\n                          </CardContent>\r\n                        </Card>\r\n                      </Grid>\r\n                    </Grid>\r\n\r\n                    <Paper sx={{ p: 2, mb: 2, backgroundColor: 'info.light', color: 'white' }}>\r\n                      <Typography variant=\"subtitle2\" gutterBottom>\r\n                        🎯 Hedef Kitle:\r\n                      </Typography>\r\n                      <Typography variant=\"body2\">\r\n                        {fleschResult.interpretation.target_audience}\r\n                      </Typography>\r\n                    </Paper>\r\n\r\n                    <Paper sx={{ p: 2, mb: 2, backgroundColor: 'warning.light' }}>\r\n                      <Typography variant=\"subtitle2\" gutterBottom>\r\n                        📊 Skor Aralığı:\r\n                      </Typography>\r\n                      <Typography variant=\"body2\">\r\n                        {fleschResult.interpretation.score_range}\r\n                      </Typography>\r\n                    </Paper>\r\n\r\n                    {fleschResult.interpretation.recommendations.length > 0 && (\r\n                      <Box>\r\n                        <Typography variant=\"subtitle2\" gutterBottom>\r\n                          💡 Öneriler:\r\n                        </Typography>\r\n                        <List dense>\r\n                          {fleschResult.interpretation.recommendations.map((rec, idx) => (\r\n                            <ListItem key={idx}>\r\n                              <ListItemIcon>\r\n                                <CheckCircle fontSize=\"small\" color=\"success\" />\r\n                              </ListItemIcon>\r\n                              <ListItemText primary={rec} />\r\n                            </ListItem>\r\n                          ))}\r\n                        </List>\r\n                      </Box>\r\n                    )}\r\n                  </>\r\n                ) : (\r\n                  <Box sx={{ textAlign: 'center', py: 8 }}>\r\n                    <Assessment sx={{ fontSize: 60, color: 'text.secondary', mb: 2 }} />\r\n                    <Typography variant=\"h6\" color=\"text.secondary\">\r\n                      Okunabilirlik analizi için \"Okunabilirlik\" butonuna tıklayın\r\n                    </Typography>\r\n                  </Box>\r\n                )}\r\n              </Box>\r\n            )}\r\n          </Paper>\r\n        </Grid>\r\n      </Grid>\r\n\r\n      {/* Information Cards */}\r\n      <Grid container spacing={3} sx={{ mt: 1 }}>\r\n        <Grid item xs={12} md={4}>\r\n          <Card elevation={2} sx={{ height: '100%' }}>\r\n            <CardContent>\r\n              <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>\r\n                <MenuBook sx={{ fontSize: 30, color: 'primary.main', mr: 1 }} />\r\n                <Typography variant=\"h6\">Seviye 1: Kelime</Typography>\r\n              </Box>\r\n              <Typography variant=\"body2\" color=\"text.secondary\">\r\n                Osmanlıca, akademik ve yabancı kökenli kelimeleri günlük Türkçe karşılıklarına dönüştürür.\r\n              </Typography>\r\n              <Box sx={{ mt: 2 }}>\r\n                <Chip label=\"mütalaa → okuma\" size=\"small\" sx={{ mr: 1, mb: 1 }} />\r\n                <Chip label=\"tetkik → inceleme\" size=\"small\" sx={{ mr: 1, mb: 1 }} />\r\n                <Chip label=\"implementasyon → uygulama\" size=\"small\" sx={{ mb: 1 }} />\r\n              </Box>\r\n            </CardContent>\r\n          </Card>\r\n        </Grid>\r\n\r\n        <Grid item xs={12} md={4}>\r\n          <Card elevation={2} sx={{ height: '100%' }}>\r\n            <CardContent>\r\n              <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>\r\n                <CompareArrows sx={{ fontSize: 30, color: 'secondary.main', mr: 1 }} />\r\n                <Typography variant=\"h6\">Seviye 2: Cümle Yapısı</Typography>\r\n              </Box>\r\n              <Typography variant=\"body2\" color=\"text.secondary\">\r\n                Karmaşık cümle yapılarını basit ve anlaşılır cümlelere böler. Uzun cümleleri kısaltır.\r\n              </Typography>\r\n              <Box sx={{ mt: 2 }}>\r\n                <Chip label=\"Pasif → Aktif\" size=\"small\" sx={{ mr: 1, mb: 1 }} />\r\n                <Chip label=\"Bağlaç Azaltma\" size=\"small\" sx={{ mr: 1, mb: 1 }} />\r\n                <Chip label=\"Cümle Bölme\" size=\"small\" sx={{ mb: 1 }} />\r\n              </Box>\r\n            </CardContent>\r\n          </Card>\r\n        </Grid>\r\n\r\n        <Grid item xs={12} md={4}>\r\n          <Card elevation={2} sx={{ height: '100%' }}>\r\n            <CardContent>\r\n              <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>\r\n                <Analytics sx={{ fontSize: 30, color: 'info.main', mr: 1 }} />\r\n                <Typography variant=\"h6\">Seviye 3: Anlam</Typography>\r\n              </Box>\r\n              <Typography variant=\"body2\" color=\"text.secondary\">\r\n                Anlamsal olarak karmaşık ifadeleri daha basit anlatım biçimlerine dönüştürür.\r\n              </Typography>\r\n              <Box sx={{ mt: 2 }}>\r\n                <Chip label=\"Mecaz → Gerçek\" size=\"small\" sx={{ mr: 1, mb: 1 }} />\r\n                <Chip label=\"Teknik → Günlük\" size=\"small\" sx={{ mr: 1, mb: 1 }} />\r\n                <Chip label=\"Soyut → Somut\" size=\"small\" sx={{ mb: 1 }} />\r\n              </Box>\r\n            </CardContent>\r\n          </Card>\r\n        </Grid>\r\n      </Grid>\r\n    </Container>\r\n  );\r\n}\r\n\r\nexport default TextSimplificationPage;\r\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\frontend\\src\\pages\\TokenOptimizationDashboard.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchStats'. Either include it or remove the dependency array.","line":111,"column":6,"nodeType":"ArrayExpression","endLine":111,"endColumn":17,"suggestions":[{"desc":"Update the dependencies array to be: [fetchStats, timeRange]","fix":{"range":[2591,2602],"text":"[fetchStats, timeRange]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Token Optimization Dashboard\r\n * Real-time monitoring of token usage and cost savings\r\n */\r\n\r\nimport {\r\n  TrendingDown,\r\n  Savings,\r\n  Assessment,\r\n  Refresh,\r\n  CloudDownload,\r\n  ArrowUpward,\r\n} from '@mui/icons-material';\r\nimport {\r\n  Box,\r\n  Card,\r\n  CardContent,\r\n  Typography,\r\n  Grid,\r\n  Chip,\r\n  LinearProgress,\r\n  Paper,\r\n  Table,\r\n  TableBody,\r\n  TableCell,\r\n  TableContainer,\r\n  TableHead,\r\n  TableRow,\r\n  Select,\r\n  MenuItem,\r\n  FormControl,\r\n  InputLabel,\r\n  IconButton,\r\n  Tooltip,\r\n} from '@mui/material';\r\nimport * as React from 'react';\nimport {  useState, useEffect  } from 'react';\r\nimport {\r\n  BarChart,\r\n  Bar,\r\n  PieChart,\r\n  Pie,\r\n  Cell,\r\n  XAxis,\r\n  YAxis,\r\n  CartesianGrid,\r\n  Tooltip as RechartsTooltip,\r\n  Legend,\r\n  ResponsiveContainer,\r\n} from 'recharts';\r\n\r\ninterface TokenStats {\r\n  total_requests: number\r\n  total_original_tokens: number\r\n  total_optimized_tokens: number\r\n  total_tokens_saved: number\r\n  average_savings_percentage: number\r\n  total_cost_saved_usd: number\r\n  provider_breakdown: {\r\n    [provider: string]: {\r\n      requests: number\r\n      original_tokens: number\r\n      optimized_tokens: number\r\n      tokens_saved: number\r\n      cost_saved_usd: number\r\n    }\r\n  }\r\n}\r\n\r\ninterface MonthlyProjection {\r\n  projected_monthly_requests: number\r\n  projected_monthly_cost_saved: number\r\n  projected_annual_cost_saved: number\r\n}\r\n\r\nconst COLORS = ['#0088FE', '#00C49F', '#FFBB28', '#FF8042'];\r\n\r\nexport const TokenOptimizationDashboard: React.FC = () => {\r\n  const [stats, setStats] = useState<TokenStats | null>(null);\r\n  const [projection, setProjection] = useState<MonthlyProjection | null>(null);\r\n  const [timeRange, setTimeRange] = useState<number>(7);\r\n  const [loading, setLoading] = useState(false);\r\n  const [lastUpdated, setLastUpdated] = useState<Date>(new Date());\r\n\r\n  const fetchStats = async () => {\r\n    setLoading(true);\r\n    try {\r\n      const [statsRes, projRes] = await Promise.all([\r\n        fetch(`/api/monitoring/token-stats?days=${timeRange}`),\r\n        fetch('/api/monitoring/token-projection'),\r\n      ]);\r\n\r\n      const statsData = await statsRes.json();\r\n      const projData = await projRes.json();\r\n\r\n      setStats(statsData);\r\n      setProjection(projData);\r\n      setLastUpdated(new Date());\r\n    } catch (error) {\r\n      console.error('Failed to fetch stats:', error);\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    fetchStats();\r\n    // Auto-refresh every 30 seconds\r\n    const interval = setInterval(fetchStats, 30000);\r\n    return () => clearInterval(interval);\r\n  }, [timeRange]);\r\n\r\n  const exportCSV = async () => {\r\n    try {\r\n      const response = await fetch(`/api/monitoring/export-csv?days=${timeRange}`);\r\n      const blob = await response.blob();\r\n      const url = window.URL.createObjectURL(blob);\r\n      const a = document.createElement('a');\r\n      a.href = url;\r\n      a.download = `token_usage_${timeRange}days.csv`;\r\n      a.click();\r\n    } catch (error) {\r\n      console.error('Failed to export CSV:', error);\r\n    }\r\n  };\r\n\r\n  if (!stats || !projection) {\r\n    return (\r\n      <Box sx={{ p: 3 }}>\r\n        <LinearProgress />\r\n      </Box>\r\n    );\r\n  }\r\n\r\n  const savingsPercentage = stats.average_savings_percentage;\r\n  const providerData = Object.entries(stats.provider_breakdown).map(([name, data]) => ({\r\n    name: name.toUpperCase(),\r\n    requests: data.requests,\r\n    tokens_saved: data.tokens_saved,\r\n    cost_saved: data.cost_saved_usd,\r\n  }));\r\n\r\n  return (\r\n    <Box sx={{ p: 3 }}>\r\n      {/* Header */}\r\n      <Box sx={{ mb: 4, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>\r\n        <div>\r\n          <Typography variant=\"h4\" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>\r\n            <Savings color=\"primary\" />\r\n            Token Optimization Dashboard\r\n          </Typography>\r\n          <Typography variant=\"body2\" color=\"text.secondary\">\r\n            Son güncelleme: {lastUpdated.toLocaleTimeString('tr-TR')}\r\n          </Typography>\r\n        </div>\r\n\r\n        <Box sx={{ display: 'flex', gap: 2 }}>\r\n          <FormControl size=\"small\" sx={{ minWidth: 150 }}>\r\n            <InputLabel>Zaman Aralığı</InputLabel>\r\n            <Select\r\n              value={timeRange}\r\n              label=\"Zaman Aralığı\"\r\n              onChange={(e) => setTimeRange(e.target.value as number)}\r\n            >\r\n              <MenuItem value={1}>Son 24 Saat</MenuItem>\r\n              <MenuItem value={7}>Son 7 Gün</MenuItem>\r\n              <MenuItem value={30}>Son 30 Gün</MenuItem>\r\n              <MenuItem value={90}>Son 90 Gün</MenuItem>\r\n            </Select>\r\n          </FormControl>\r\n\r\n          <Tooltip title=\"Yenile\">\r\n            <IconButton onClick={fetchStats} disabled={loading}>\r\n              <Refresh />\r\n            </IconButton>\r\n          </Tooltip>\r\n\r\n          <Tooltip title=\"CSV İndir\">\r\n            <IconButton onClick={exportCSV}>\r\n              <CloudDownload />\r\n            </IconButton>\r\n          </Tooltip>\r\n        </Box>\r\n      </Box>\r\n\r\n      {/* Key Metrics */}\r\n      <Grid container spacing={3} sx={{ mb: 4 }}>\r\n        <Grid item xs={12} sm={6} md={3}>\r\n          <Card>\r\n            <CardContent>\r\n              <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'start' }}>\r\n                <div>\r\n                  <Typography color=\"text.secondary\" gutterBottom variant=\"body2\">\r\n                    Toplam İstek\r\n                  </Typography>\r\n                  <Typography variant=\"h4\" fontWeight=\"bold\">\r\n                    {stats.total_requests.toLocaleString()}\r\n                  </Typography>\r\n                </div>\r\n                <Assessment color=\"primary\" sx={{ fontSize: 40, opacity: 0.3 }} />\r\n              </Box>\r\n            </CardContent>\r\n          </Card>\r\n        </Grid>\r\n\r\n        <Grid item xs={12} sm={6} md={3}>\r\n          <Card>\r\n            <CardContent>\r\n              <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'start' }}>\r\n                <div>\r\n                  <Typography color=\"text.secondary\" gutterBottom variant=\"body2\">\r\n                    Token Tasarrufu\r\n                  </Typography>\r\n                  <Typography variant=\"h4\" fontWeight=\"bold\" color=\"success.main\">\r\n                    {stats.total_tokens_saved.toLocaleString()}\r\n                  </Typography>\r\n                  <Chip\r\n                    label={`${savingsPercentage.toFixed(1)}%`}\r\n                    size=\"small\"\r\n                    color=\"success\"\r\n                    icon={<TrendingDown />}\r\n                  />\r\n                </div>\r\n                <TrendingDown color=\"success\" sx={{ fontSize: 40, opacity: 0.3 }} />\r\n              </Box>\r\n            </CardContent>\r\n          </Card>\r\n        </Grid>\r\n\r\n        <Grid item xs={12} sm={6} md={3}>\r\n          <Card>\r\n            <CardContent>\r\n              <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'start' }}>\r\n                <div>\r\n                  <Typography color=\"text.secondary\" gutterBottom variant=\"body2\">\r\n                    Maliyet Tasarrufu\r\n                  </Typography>\r\n                  <Typography variant=\"h4\" fontWeight=\"bold\" color=\"success.main\">\r\n                    ${stats.total_cost_saved_usd.toFixed(2)}\r\n                  </Typography>\r\n                  <Typography variant=\"caption\" color=\"text.secondary\">\r\n                    Son {timeRange} gün\r\n                  </Typography>\r\n                </div>\r\n                <Savings color=\"success\" sx={{ fontSize: 40, opacity: 0.3 }} />\r\n              </Box>\r\n            </CardContent>\r\n          </Card>\r\n        </Grid>\r\n\r\n        <Grid item xs={12} sm={6} md={3}>\r\n          <Card>\r\n            <CardContent>\r\n              <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'start' }}>\r\n                <div>\r\n                  <Typography color=\"text.secondary\" gutterBottom variant=\"body2\">\r\n                    Aylık Projeksiyon\r\n                  </Typography>\r\n                  <Typography variant=\"h4\" fontWeight=\"bold\" color=\"primary\">\r\n                    ${projection.projected_monthly_cost_saved.toFixed(2)}\r\n                  </Typography>\r\n                  <Typography variant=\"caption\" color=\"text.secondary\">\r\n                    ~${projection.projected_annual_cost_saved.toFixed(0)}/yıl\r\n                  </Typography>\r\n                </div>\r\n                <ArrowUpward color=\"primary\" sx={{ fontSize: 40, opacity: 0.3 }} />\r\n              </Box>\r\n            </CardContent>\r\n          </Card>\r\n        </Grid>\r\n      </Grid>\r\n\r\n      {/* Charts */}\r\n      <Grid container spacing={3} sx={{ mb: 4 }}>\r\n        {/* Provider Breakdown - Bar Chart */}\r\n        <Grid item xs={12} md={6}>\r\n          <Card>\r\n            <CardContent>\r\n              <Typography variant=\"h6\" gutterBottom>\r\n                Provider Bazında Token Tasarrufu\r\n              </Typography>\r\n              <ResponsiveContainer width=\"100%\" height={300}>\r\n                <BarChart data={providerData}>\r\n                  <CartesianGrid strokeDasharray=\"3 3\" />\r\n                  <XAxis dataKey=\"name\" />\r\n                  <YAxis />\r\n                  <RechartsTooltip />\r\n                  <Legend />\r\n                  <Bar dataKey=\"tokens_saved\" fill=\"#8884d8\" name=\"Token Tasarrufu\" />\r\n                </BarChart>\r\n              </ResponsiveContainer>\r\n            </CardContent>\r\n          </Card>\r\n        </Grid>\r\n\r\n        {/* Provider Distribution - Pie Chart */}\r\n        <Grid item xs={12} md={6}>\r\n          <Card>\r\n            <CardContent>\r\n              <Typography variant=\"h6\" gutterBottom>\r\n                Provider Kullanım Dağılımı\r\n              </Typography>\r\n              <ResponsiveContainer width=\"100%\" height={300}>\r\n                <PieChart>\r\n                  <Pie\r\n                    data={providerData}\r\n                    dataKey=\"requests\"\r\n                    nameKey=\"name\"\r\n                    cx=\"50%\"\r\n                    cy=\"50%\"\r\n                    outerRadius={100}\r\n                    label\r\n                  >\r\n                    {providerData.map((_entry, index) => (\r\n                      <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />\r\n                    ))}\r\n                  </Pie>\r\n                  <RechartsTooltip />\r\n                  <Legend />\r\n                </PieChart>\r\n              </ResponsiveContainer>\r\n            </CardContent>\r\n          </Card>\r\n        </Grid>\r\n      </Grid>\r\n\r\n      {/* Provider Details Table */}\r\n      <Card>\r\n        <CardContent>\r\n          <Typography variant=\"h6\" gutterBottom>\r\n            Provider Detayları\r\n          </Typography>\r\n          <TableContainer component={Paper} variant=\"outlined\">\r\n            <Table>\r\n              <TableHead>\r\n                <TableRow>\r\n                  <TableCell><strong>Provider</strong></TableCell>\r\n                  <TableCell align=\"right\"><strong>İstek Sayısı</strong></TableCell>\r\n                  <TableCell align=\"right\"><strong>Orijinal Token</strong></TableCell>\r\n                  <TableCell align=\"right\"><strong>Optimize Token</strong></TableCell>\r\n                  <TableCell align=\"right\"><strong>Tasarruf</strong></TableCell>\r\n                  <TableCell align=\"right\"><strong>Tasarruf %</strong></TableCell>\r\n                  <TableCell align=\"right\"><strong>Maliyet Tasarrufu</strong></TableCell>\r\n                </TableRow>\r\n              </TableHead>\r\n              <TableBody>\r\n                {providerData.map((provider) => {\r\n                  const savingsPct = ((provider.tokens_saved / stats.provider_breakdown[provider.name.toLowerCase()].original_tokens) * 100) || 0;\r\n                  return (\r\n                    <TableRow key={provider.name}>\r\n                      <TableCell>\r\n                        <Chip label={provider.name} size=\"small\" color=\"primary\" variant=\"outlined\" />\r\n                      </TableCell>\r\n                      <TableCell align=\"right\">{provider.requests.toLocaleString()}</TableCell>\r\n                      <TableCell align=\"right\">\r\n                        {stats.provider_breakdown[provider.name.toLowerCase()].original_tokens.toLocaleString()}\r\n                      </TableCell>\r\n                      <TableCell align=\"right\">\r\n                        {stats.provider_breakdown[provider.name.toLowerCase()].optimized_tokens.toLocaleString()}\r\n                      </TableCell>\r\n                      <TableCell align=\"right\">\r\n                        <Typography color=\"success.main\" fontWeight=\"bold\">\r\n                          {provider.tokens_saved.toLocaleString()}\r\n                        </Typography>\r\n                      </TableCell>\r\n                      <TableCell align=\"right\">\r\n                        <Chip\r\n                          label={`${savingsPct.toFixed(1)}%`}\r\n                          size=\"small\"\r\n                          color={savingsPct >= 5 ? 'success' : savingsPct >= 3 ? 'warning' : 'default'}\r\n                        />\r\n                      </TableCell>\r\n                      <TableCell align=\"right\">\r\n                        <Typography color=\"success.main\" fontWeight=\"bold\">\r\n                          ${provider.cost_saved.toFixed(4)}\r\n                        </Typography>\r\n                      </TableCell>\r\n                    </TableRow>\r\n                  );\r\n                })}\r\n              </TableBody>\r\n            </Table>\r\n          </TableContainer>\r\n        </CardContent>\r\n      </Card>\r\n    </Box>\r\n  );\r\n};\r\n\r\nexport default TokenOptimizationDashboard;\r\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\frontend\\src\\pages\\TypographySettingsPage.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":50,"column":33,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[1806,1992],"text":"\r\n                  Renkli overlay&apos;ler, beyaz sayfa parlaklığını azaltır ve göz yorgunluğunu önler.\r\n                  Her kişi için farklı renkler daha rahat olabilir.\r\n                "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[1806,1992],"text":"\r\n                  Renkli overlay&lsquo;ler, beyaz sayfa parlaklığını azaltır ve göz yorgunluğunu önler.\r\n                  Her kişi için farklı renkler daha rahat olabilir.\r\n                "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[1806,1992],"text":"\r\n                  Renkli overlay&#39;ler, beyaz sayfa parlaklığını azaltır ve göz yorgunluğunu önler.\r\n                  Her kişi için farklı renkler daha rahat olabilir.\r\n                "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo