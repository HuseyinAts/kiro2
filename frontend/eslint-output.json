m '@/api';\r\nimport config from '@/config';\r\nimport { useErrorHandler, AppError, ErrorType } from '@/utils/errorHandler';\r\n\r\ninterface DashboardData {\r\n  stats: any;\r\n  examHistory: any[];\r\n}\r\n\r\nexport const DashboardWithErrorHandling: React.FC = () => {\r\n  const [data, setData] = useState<DashboardData | null>(null);\r\n  const [loading, setLoading] = useState(true);\r\n  const [error, setError] = useState<AppError | null>(null);\r\n  const [retryCount, setRetryCount] = useState(0);\r\n\r\n  const { handleError, getUserMessage, isRecoverable } = useErrorHandler();\r\n\r\n  const loadDashboard = async (isRetry = false) => {\r\n    if (!isRetry) {\r\n      setLoading(true);\r\n    }\r\n    setError(null);\r\n\r\n    try {\r\n      // Parallel API calls\r\n      const [stats, examHistory] = await Promise.all([\r\n        getDashboardStats(),\r\n        getExamHistory(10),\r\n      ]);\r\n\r\n      setData({ stats, examHistory });\r\n      setRetryCount(0); // Reset retry count on success\r\n\r\n      // Log success (only in production)\r\n      if (config.isProduction && config.features.analytics) {\r\n        console.log('Dashboard loaded successfully');\r\n      }\r\n    } catch (err) {\r\n      const appError = handleError(err, 'loadDashboard');\r\n      setError(appError);\r\n\r\n      // Auto-retry for network errors\r\n      if (isRecoverable(appError) && retryCount < 3) {\r\n        const delay = Math.pow(2, retryCount) * 1000; // Exponential backoff\r\n        console.log(`Retrying in ${delay}ms... (Attempt ${retryCount + 1}/3)`);\r\n\r\n        setTimeout(() => {\r\n          setRetryCount((prev) => prev + 1);\r\n          loadDashboard(true);\r\n        }, delay);\r\n      }\r\n    } finally {\r\n      if (!isRetry) {\r\n        setLoading(false);\r\n      }\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    loadDashboard();\r\n  }, []);\r\n\r\n  // Render loading state\r\n  if (loading) {\r\n    return (\r\n      <div className=\"dashboard-loading\">\r\n        <div className=\"spinner\" />\r\n        <p>Dashboard yükleniyor...</p>\r\n        {config.isDevelopment && <p className=\"debug\">API URL: {config.api.baseURL}</p>}\r\n      </div>\r\n    );\r\n  }\r\n\r\n  // Render error state\r\n  if (error) {\r\n    return (\r\n      <div className={`dashboard-error error-${error.type}`}>\r\n        <div className=\"error-icon\">⚠️</div>\r\n        <h3>Dashboard Yüklenemedi</h3>\r\n        <p className=\"error-message\">{getUserMessage(error)}</p>\r\n\r\n        {/* Error-specific actions */}\r\n        {error.type === ErrorType.NETWORK && (\r\n          <div className=\"error-actions\">\r\n            <p className=\"hint\">İnternet bağlantınızı kontrol edin</p>\r\n            <button onClick={() => loadDashboard()}>Tekrar Dene</button>\r\n          </div>\r\n        )}\r\n\r\n        {error.type === ErrorType.AUTH && (\r\n          <div className=\"error-actions\">\r\n            <p className=\"hint\">Oturumunuz sona ermiş olabilir</p>\r\n            <button onClick={() => (window.location.href = '/login')}>\r\n              Tekrar Giriş Yap\r\n            </button>\r\n          </div>\r\n        )}\r\n\r\n        {error.type === ErrorType.SERVER && (\r\n          <div className=\"error-actions\">\r\n            <p className=\"hint\">Sunucu geçici olarak kullanılamıyor</p>\r\n            <button onClick={() => loadDashboard()}>Tekrar Dene</button>\r\n          </div>\r\n        )}\r\n\r\n        {/* Show retry status */}\r\n        {isRecoverable(error) && retryCount > 0 && (\r\n          <p className=\"retry-status\">\r\n            Otomatik yeniden deneme: {retryCount}/3\r\n          </p>\r\n        )}\r\n\r\n        {/* Debug info (development only) */}\r\n        {config.isDevelopment && error.details && (\r\n          <details className=\"error-details\">\r\n            <summary>Teknik Detaylar (Development)</summary>\r\n            <pre>{JSON.stringify(error.details, null, 2)}</pre>\r\n            <p>Status: {error.status}</p>\r\n            <p>Timestamp: {error.timestamp?.toISOString()}</p>\r\n          </details>\r\n        )}\r\n      </div>\r\n    );\r\n  }\r\n\r\n  // Render success state\r\n  return (\r\n    <div className=\"dashboard-success\">\r\n      <h2>Dashboard</h2>\r\n\r\n      {/* Stats Section */}\r\n      <div className=\"stats-section\">\r\n        <h3>İstatistikler</h3>\r\n        {data?.stats && (\r\n          <div className=\"stats-grid\">\r\n            <div className=\"stat-card\">\r\n              <span className=\"stat-label\">Toplam Sınav</span>\r\n              <span className=\"stat-value\">{data.stats.total_exams || 0}</span>\r\n            </div>\r\n            <div className=\"stat-card\">\r\n              <span className=\"stat-label\">Ortalama Puan</span>\r\n              <span className=\"stat-value\">{data.stats.average_score || 0}</span>\r\n            </div>\r\n          </div>\r\n        )}\r\n      </div>\r\n\r\n      {/* Exam History Section */}\r\n      <div className=\"exam-history-section\">\r\n        <h3>Sınav Geçmişi</h3>\r\n        {data?.examHistory && data.examHistory.length > 0 ? (\r\n          <ul className=\"exam-list\">\r\n            {data.examHistory.map((exam, index) => (\r\n              <li key={exam.id || index} className=\"exam-item\">\r\n                <span>{exam.exam_type}</span>\r\n                <span>{exam.score}</span>\r\n                <span>{new Date(exam.date).toLocaleDateString('tr-TR')}</span>\r\n              </li>\r\n            ))}\r\n          </ul>\r\n        ) : (\r\n          <p className=\"no-data\">Henüz sınav kaydı yok</p>\r\n        )}\r\n      </div>\r\n\r\n      {/* Refresh Button */}\r\n      <button onClick={() => loadDashboard()} className=\"refresh-button\">\r\n        Yenile\r\n      </button>\r\n\r\n      {/* Environment Badge (development only) */}\r\n      {config.isDevelopment && (\r\n        <div className=\"dev-badge\">\r\n          <span>Environment: {config.app.env}</span>\r\n          <span>API: {config.api.baseURL}</span>\r\n          <span>Test Mode: {config.isTest ? 'Yes' : 'No'}</span>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default DashboardWithErrorHandling;\r\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\frontend\\src\\components\\Examples\\ErrorHandlerDemo.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":15,"column":36,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":15,"endColumn":39,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[481,484],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[481,484],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":36,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":36,"endColumn":20,"suggestions":[{"messageId":"removeConsole","data":{"propertyName":"log"},"fix":{"range":[1059,1107],"text":""},"desc":"Remove the console.log()."}]},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":79,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":79,"endColumn":38},{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":80,"column":28,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":80,"endColumn":59},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":85,"column":53,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":85,"endColumn":56,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2452,2455],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2452,2455],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":86,"column":18,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":86,"endColumn":21,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2483,2486],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2483,2486],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":93,"column":53,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":93,"endColumn":56,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2715,2718],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2715,2718],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":94,"column":18,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":94,"endColumn":21,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2748,2751],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2748,2751],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Error Handler Demo Component\r\n * Merkezi error handling kullanımı örneği\r\n */\r\n\r\nimport * as React from 'react';\nimport {  useState  } from 'react';\n\r\nimport { getDashboardStats } from '@/api';\r\nimport { useErrorHandler, ErrorType, AppError } from '@/utils/errorHandler';\r\n\r\nexport const ErrorHandlerDemo: React.FC = () => {\r\n  const [loading, setLoading] = useState(false);\r\n  const [error, setError] = useState<AppError | null>(null);\r\n  const [data, setData] = useState<any>(null);\r\n\r\n  const { handleError, getUserMessage, isRecoverable } = useErrorHandler();\r\n\r\n  const fetchData = async () => {\r\n    setLoading(true);\r\n    setError(null);\r\n\r\n    try {\r\n      const result = await getDashboardStats();\r\n      setData(result);\r\n    } catch (err) {\r\n      // Centralized error handling\r\n      const appError = handleError(err, 'fetchData');\r\n      setError(appError);\r\n\r\n      // Show user-friendly message\r\n      console.error(getUserMessage(appError));\r\n\r\n      // Auto-retry for recoverable errors\r\n      if (isRecoverable(appError)) {\r\n        console.log('Recoverable error, will retry...');\r\n        setTimeout(fetchData, 2000); // Retry after 2s\r\n      }\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className=\"error-handler-demo\">\r\n      <h2>Error Handler Demo</h2>\r\n\r\n      <button onClick={fetchData} disabled={loading}>\r\n        {loading ? 'Loading...' : 'Fetch Dashboard Stats'}\r\n      </button>\r\n\r\n      {error && (\r\n        <div className={`error-message ${error.type}`}>\r\n          <h3>Error Type: {error.type}</h3>\r\n          <p>{getUserMessage(error)}</p>\r\n          {isRecoverable(error) && (\r\n            <p className=\"retry-hint\">This error is recoverable. Auto-retrying...</p>\r\n          )}\r\n          {error.details && (\r\n            <pre>{JSON.stringify(error.details, null, 2)}</pre>\r\n          )}\r\n        </div>\r\n      )}\r\n\r\n      {data && (\r\n        <div className=\"success-message\">\r\n          <h3>Data Loaded Successfully</h3>\r\n          <pre>{JSON.stringify(data, null, 2)}</pre>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\n/**\r\n * Example: Global Error Listener\r\n * Log all errors to analytics\r\n */\r\nexport const setupGlobalErrorTracking = () => {\r\n  const { errorHandler } = require('@/utils/errorHandler');\r\n\r\n  // Register global listener\r\n  errorHandler.onError((error: AppError) => {\r\n    // Send to analytics\r\n    if (typeof window !== 'undefined' && (window as any).gtag) {\r\n      (window as any).gtag('event', 'exception', {\r\n        description: error.message,\r\n        fatal: error.type === ErrorType.SERVER,\r\n      });\r\n    }\r\n\r\n    // Send to Sentry (if configured)\r\n    if (typeof window !== 'undefined' && (window as any).Sentry) {\r\n      (window as any).Sentry.captureException(new Error(error.message), {\r\n        extra: {\r\n          type: error.type,\r\n          status: error.status,\r\n          details: error.details,\r\n        },\r\n      });\r\n    }\r\n\r\n    // Log to console in development\r\n    if (process.env.NODE_ENV === 'development') {\r\n      console.error('[Global Error Handler]', error);\r\n    }\r\n  });\r\n};\r\n\r\nexport default ErrorHandlerDemo;\r\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\frontend\\src\\components\\Gamification\\BadgeCollection.tsx","messages":[{"ruleId":"jsx-a11y/click-events-have-key-events","severity":1,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":164,"column":13,"nodeType":"JSXOpeningElement","endLine":171,"endColumn":14},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":1,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":164,"column":13,"nodeType":"JSXOpeningElement","endLine":171,"endColumn":14},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":1,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":205,"column":9,"nodeType":"JSXOpeningElement","endLine":205,"endColumn":85},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":1,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":205,"column":9,"nodeType":"JSXOpeningElement","endLine":205,"endColumn":85},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":1,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":206,"column":11,"nodeType":"JSXOpeningElement","endLine":206,"endColumn":77},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":1,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":206,"column":11,"nodeType":"JSXOpeningElement","endLine":206,"endColumn":77}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * BadgeCollection Component - Task 91\r\n * Rozet koleksiyonu ve ilerleme gösterimi\r\n */\r\nimport * as React from 'react';\nimport {  useState, useMemo  } from 'react';\n\r\nimport { useBadges, Badge, BadgeProgress } from '../../hooks/useGamification';\r\nimport './BadgeCollection.css';\r\n\r\ninterface BadgeCollectionProps {\r\n  showProgress?: boolean;\r\n  filterByCategory?: string;\r\n  compact?: boolean;\r\n}\r\n\r\nconst RARITY_COLORS = {\r\n  common: '#94a3b8',\r\n  uncommon: '#22c55e',\r\n  rare: '#3b82f6',\r\n  epic: '#a855f7',\r\n  legendary: '#f59e0b',\r\n};\r\n\r\nconst CATEGORY_ICONS: Record<string, string> = {\r\n  achievement: '🎯',\r\n  milestone: '🏆',\r\n  streak: '🔥',\r\n  mastery: '⭐',\r\n  special: '💎',\r\n  seasonal: '🎃',\r\n};\r\n\r\nexport const BadgeCollection: React.FC<BadgeCollectionProps> = ({\r\n  showProgress = true,\r\n  filterByCategory,\r\n  compact = false,\r\n}) => {\r\n  const { allBadges, earnedBadges, badgeProgress, loading, error } = useBadges();\r\n  const [selectedBadge, setSelectedBadge] = useState<Badge | BadgeProgress | null>(null);\r\n  const [filterRarity, setFilterRarity] = useState<string>('all');\r\n  const [viewMode, setViewMode] = useState<'earned' | 'all' | 'progress'>('earned');\r\n\r\n  const filteredBadges = useMemo(() => {\r\n    let badges: (Badge | BadgeProgress)[] = [];\r\n\r\n    if (viewMode === 'earned') {\r\n      badges = earnedBadges;\r\n    } else if (viewMode === 'all') {\r\n      badges = allBadges;\r\n    } else {\r\n      badges = badgeProgress;\r\n    }\r\n\r\n    if (filterByCategory) {\r\n      badges = badges.filter(b => b.category === filterByCategory);\r\n    }\r\n\r\n    if (filterRarity !== 'all') {\r\n      badges = badges.filter(b => b.rarity === filterRarity);\r\n    }\r\n\r\n    return badges;\r\n  }, [viewMode, earnedBadges, allBadges, badgeProgress, filterByCategory, filterRarity]);\r\n\r\n  const stats = useMemo(() => {\r\n    const byRarity: Record<string, number> = {};\r\n    earnedBadges.forEach(badge => {\r\n      byRarity[badge.rarity] = (byRarity[badge.rarity] || 0) + 1;\r\n    });\r\n\r\n    return {\r\n      total: earnedBadges.length,\r\n      available: allBadges.length,\r\n      byRarity,\r\n    };\r\n  }, [earnedBadges, allBadges]);\r\n\r\n  if (loading && earnedBadges.length === 0) {\r\n    return (\r\n      <div className=\"badge-collection loading\">\r\n        <div className=\"spinner\"></div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (error) {\r\n    return (\r\n      <div className=\"badge-collection error\">\r\n        <span className=\"error-icon\">⚠️</span>\r\n        <span className=\"error-message\">Rozetler yüklenemedi</span>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (compact) {\r\n    return (\r\n      <div className=\"badge-collection compact\">\r\n        <span className=\"badge-count-icon\">🏅</span>\r\n        <span className=\"badge-count\">{stats.total}/{stats.available}</span>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"badge-collection\">\r\n      <div className=\"badge-header\">\r\n        <h3>Rozet Koleksiyonu</h3>\r\n        <div className=\"badge-stats-compact\">\r\n          <span className=\"stat-badge\">\r\n            <span className=\"stat-icon\">🏅</span>\r\n            <span className=\"stat-value\">{stats.total}/{stats.available}</span>\r\n          </span>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"badge-filters\">\r\n        <div className=\"view-mode-buttons\">\r\n          <button\r\n            className={`view-mode-btn ${viewMode === 'earned' ? 'active' : ''}`}\r\n            onClick={() => setViewMode('earned')}\r\n          >\r\n            Kazanılanlar ({earnedBadges.length})\r\n          </button>\r\n          <button\r\n            className={`view-mode-btn ${viewMode === 'all' ? 'active' : ''}`}\r\n            onClick={() => setViewMode('all')}\r\n          >\r\n            Tümü ({allBadges.length})\r\n          </button>\r\n          {showProgress && (\r\n            <button\r\n              className={`view-mode-btn ${viewMode === 'progress' ? 'active' : ''}`}\r\n              onClick={() => setViewMode('progress')}\r\n            >\r\n              İlerleme ({badgeProgress.length})\r\n            </button>\r\n          )}\r\n        </div>\r\n\r\n        <div className=\"rarity-filter\">\r\n          <select\r\n            value={filterRarity}\r\n            onChange={(e) => setFilterRarity(e.target.value)}\r\n            className=\"rarity-select\"\r\n          >\r\n            <option value=\"all\">Tüm Nadirlikler</option>\r\n            <option value=\"common\">Yaygın</option>\r\n            <option value=\"uncommon\">Nadir</option>\r\n            <option value=\"rare\">Çok Nadir</option>\r\n            <option value=\"epic\">Epik</option>\r\n            <option value=\"legendary\">Efsanevi</option>\r\n          </select>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"badge-grid\">\r\n        {filteredBadges.length === 0 ? (\r\n          <div className=\"no-badges\">\r\n            {viewMode === 'earned' ? 'Henüz rozet kazanmadınız' : 'Rozet bulunamadı'}\r\n          </div>\r\n        ) : (\r\n          filteredBadges.map((badge) => (\r\n            <div\r\n              key={badge.badge_id}\r\n              className={`badge-card ${badge.rarity} ${\r\n                'earned_at' in badge ? 'earned' : ''\r\n              }`}\r\n              onClick={() => setSelectedBadge(badge)}\r\n              style={{ borderColor: RARITY_COLORS[badge.rarity] }}\r\n            >\r\n              <div className=\"badge-icon\">{badge.icon}</div>\r\n              <div className=\"badge-name\">{badge.name}</div>\r\n              <div className=\"badge-category\">\r\n                {CATEGORY_ICONS[badge.category] || '📌'} {badge.category}\r\n              </div>\r\n              <div className=\"badge-points\">+{badge.points} puan</div>\r\n\r\n              {viewMode === 'progress' && 'progress_percentage' in badge && (\r\n                <div className=\"badge-progress-bar\">\r\n                  <div\r\n                    className=\"badge-progress-fill\"\r\n                    style={{\r\n                      width: `${badge.progress_percentage}%`,\r\n                      background: RARITY_COLORS[badge.rarity],\r\n                    }}\r\n                  ></div>\r\n                  <span className=\"badge-progress-text\">\r\n                    {Math.round(badge.progress_percentage)}%\r\n                  </span>\r\n                </div>\r\n              )}\r\n\r\n              {/* 'earned_at' in badge && badge.earned_at && (\r\n                <div className=\"badge-earned-date\">\r\n                  {new Date(badge.earned_at).toLocaleDateString('tr-TR')}\r\n                </div>\r\n              ) */}\r\n            </div>\r\n          ))\r\n        )}\r\n      </div>\r\n\r\n      {selectedBadge && (\r\n        <div className=\"badge-modal-overlay\" onClick={() => setSelectedBadge(null)}>\r\n          <div className=\"badge-modal\" onClick={(e) => e.stopPropagation()}>\r\n            <button\r\n              className=\"modal-close\"\r\n              onClick={() => setSelectedBadge(null)}\r\n              aria-label=\"Kapat\"\r\n            >\r\n              ✕\r\n            </button>\r\n\r\n            <div\r\n              className=\"modal-badge-icon\"\r\n              style={{ color: RARITY_COLORS[selectedBadge.rarity] }}\r\n            >\r\n              {selectedBadge.icon}\r\n            </div>\r\n\r\n            <h2 className=\"modal-badge-name\">{selectedBadge.name}</h2>\r\n\r\n            <div\r\n              className=\"modal-rarity-badge\"\r\n              style={{ background: RARITY_COLORS[selectedBadge.rarity] }}\r\n            >\r\n              {selectedBadge.rarity.toUpperCase()}\r\n            </div>\r\n\r\n            <p className=\"modal-badge-description\">{selectedBadge.description}</p>\r\n\r\n            <div className=\"modal-badge-info\">\r\n              <div className=\"modal-info-item\">\r\n                <span className=\"modal-info-label\">Kategori:</span>\r\n                <span className=\"modal-info-value\">\r\n                  {CATEGORY_ICONS[selectedBadge.category] || '📌'} {selectedBadge.category}\r\n                </span>\r\n              </div>\r\n              <div className=\"modal-info-item\">\r\n                <span className=\"modal-info-label\">Puan:</span>\r\n                <span className=\"modal-info-value\">+{selectedBadge.points}</span>\r\n              </div>\r\n              {'earned_at' in selectedBadge && selectedBadge.earned_at && (\r\n                <div className=\"modal-info-item\">\r\n                  <span className=\"modal-info-label\">Kazanma Tarihi:</span>\r\n                  <span className=\"modal-info-value\">\r\n                    {new Date(selectedBadge.earned_at).toLocaleDateString('tr-TR', {\r\n                      day: 'numeric',\r\n                      month: 'long',\r\n                      year: 'numeric',\r\n                    })}\r\n                  </span>\r\n                </div>\r\n              )}\r\n            </div>\r\n\r\n            {viewMode === 'progress' && 'progress_percentage' in selectedBadge && (\r\n              <div className=\"modal-progress\">\r\n                <h3>İlerleme</h3>\r\n                <div className=\"modal-progress-bar\">\r\n                  <div\r\n                    className=\"modal-progress-fill\"\r\n                    style={{\r\n                      width: `${selectedBadge.progress_percentage}%`,\r\n                      background: RARITY_COLORS[selectedBadge.rarity],\r\n                    }}\r\n                  ></div>\r\n                </div>\r\n                <div className=\"modal-progress-text\">\r\n                  {Math.round(selectedBadge.progress_percentage)}% tamamlandı\r\n                </div>\r\n\r\n                {selectedBadge.criteria && (\r\n                  <div className=\"modal-criteria\">\r\n                    <h4>Kriterler</h4>\r\n                    <ul>\r\n                      {Object.entries(selectedBadge.criteria).map(([key, value]) => (\r\n                        <li key={key}>\r\n                          {key}: {value}\r\n                        </li>\r\n                      ))}\r\n                    </ul>\r\n                  </div>\r\n                )}\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default BadgeCollection;\r\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\frontend\\src\\components\\Gamification\\GamificationDashboard.tsx","messages":[{"ruleId":"import/no-named-as-default","severity":1,"message":"Using exported name 'BadgeCollection' as identifier for default import.","line":9,"column":8,"nodeType":"ImportDefaultSpecifier","endLine":9,"endColumn":23},{"ruleId":"import/no-named-as-default","severity":1,"message":"Using exported name 'Leaderboard' as identifier for default import.","line":10,"column":8,"nodeType":"ImportDefaultSpecifier","endLine":10,"endColumn":19},{"ruleId":"import/no-named-as-default","severity":1,"message":"Using exported name 'LevelDisplay' as identifier for default import.","line":11,"column":8,"nodeType":"ImportDefaultSpecifier","endLine":11,"endColumn":20},{"ruleId":"import/no-named-as-default","severity":1,"message":"Using exported name 'PointsDisplay' as identifier for default import.","line":12,"column":8,"nodeType":"ImportDefaultSpecifier","endLine":12,"endColumn":21}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * GamificationDashboard Component - Task 91\r\n * Tüm oyunlaştırma özelliklerini tek bir dashboard'da gösteren ana component\r\n */\r\nimport * as React from 'react';\n\r\nimport { useGamificationStats } from '../../hooks/useGamification';\n\r\nimport BadgeCollection from './BadgeCollection';\r\nimport Leaderboard from './Leaderboard';\r\nimport LevelDisplay from './LevelDisplay';\r\nimport PointsDisplay from './PointsDisplay';\r\nimport './GamificationDashboard.css';\r\n\r\ninterface GamificationDashboardProps {\r\n  layout?: 'grid' | 'tabs';\r\n}\r\n\r\nexport const GamificationDashboard: React.FC<GamificationDashboardProps> = ({\r\n  layout = 'grid',\r\n}) => {\r\n  const { stats, loading, error } = useGamificationStats();\r\n  const [activeTab, setActiveTab] = React.useState<'overview' | 'badges' | 'leaderboard'>('overview');\r\n\r\n  if (loading && !stats) {\r\n    return (\r\n      <div className=\"gamification-dashboard loading\">\r\n        <div className=\"spinner-large\"></div>\r\n        <p>Oyunlaştırma verileri yükleniyor...</p>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (error) {\r\n    return (\r\n      <div className=\"gamification-dashboard error\">\r\n        <span className=\"error-icon\">⚠️</span>\r\n        <h3>Bir hata oluştu</h3>\r\n        <p>{error}</p>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (layout === 'tabs') {\r\n    return (\r\n      <div className=\"gamification-dashboard tabs-layout\">\r\n        <div className=\"dashboard-header\">\r\n          <h2>Oyunlaştırma</h2>\r\n          <div className=\"quick-stats\">\r\n            <div className=\"quick-stat\">\r\n              <span className=\"stat-icon\">⭐</span>\r\n              <span className=\"stat-value\">{stats?.points.toLocaleString('tr-TR')}</span>\r\n              <span className=\"stat-label\">Puan</span>\r\n            </div>\r\n            <div className=\"quick-stat\">\r\n              <span className=\"stat-icon\">⚡</span>\r\n              <span className=\"stat-value\">{stats?.level}</span>\r\n              <span className=\"stat-label\">Seviye</span>\r\n            </div>\r\n            <div className=\"quick-stat\">\r\n              <span className=\"stat-icon\">🏅</span>\r\n              <span className=\"stat-value\">{stats?.total_badges}</span>\r\n              <span className=\"stat-label\">Rozet</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"dashboard-tabs\">\r\n          <button\r\n            className={`dashboard-tab ${activeTab === 'overview' ? 'active' : ''}`}\r\n            onClick={() => setActiveTab('overview')}\r\n          >\r\n            <span className=\"tab-icon\">📊</span>\r\n            <span className=\"tab-label\">Genel Bakış</span>\r\n          </button>\r\n          <button\r\n            className={`dashboard-tab ${activeTab === 'badges' ? 'active' : ''}`}\r\n            onClick={() => setActiveTab('badges')}\r\n          >\r\n            <span className=\"tab-icon\">🏅</span>\r\n            <span className=\"tab-label\">Rozetler</span>\r\n          </button>\r\n          <button\r\n            className={`dashboard-tab ${activeTab === 'leaderboard' ? 'active' : ''}`}\r\n            onClick={() => setActiveTab('leaderboard')}\r\n          >\r\n            <span className=\"tab-icon\">🏆</span>\r\n            <span className=\"tab-label\">Liderlik Tablosu</span>\r\n          </button>\r\n        </div>\r\n\r\n        <div className=\"dashboard-content\">\r\n          {activeTab === 'overview' && (\r\n            <div className=\"overview-grid\">\r\n              <div className=\"overview-section\">\r\n                <PointsDisplay showHistory={true} />\r\n              </div>\r\n              <div className=\"overview-section\">\r\n                <LevelDisplay showMilestones={true} />\r\n              </div>\r\n              {stats && stats.recent_achievements.length > 0 && (\r\n                <div className=\"overview-section recent-achievements\">\r\n                  <h3>Son Başarılar</h3>\r\n                  <div className=\"achievements-list\">\r\n                    {stats.recent_achievements.map((badge) => (\r\n                      <div key={badge.badge_id} className=\"achievement-item\">\r\n                        <span className=\"achievement-icon\">{badge.icon}</span>\r\n                        <div className=\"achievement-info\">\r\n                          <div className=\"achievement-name\">{badge.name}</div>\r\n                          <div className=\"achievement-date\">\r\n                            {badge.earned_at &&\r\n                              new Date(badge.earned_at).toLocaleDateString('tr-TR')}\r\n                          </div>\r\n                        </div>\r\n                        <div className=\"achievement-points\">+{badge.points}</div>\r\n                      </div>\r\n                    ))}\r\n                  </div>\r\n                </div>\r\n              )}\r\n            </div>\r\n          )}\r\n\r\n          {activeTab === 'badges' && <BadgeCollection showProgress={true} />}\r\n\r\n          {activeTab === 'leaderboard' && <Leaderboard showNearby={true} limit={50} />}\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  // Grid layout\r\n  return (\r\n    <div className=\"gamification-dashboard grid-layout\">\r\n      <div className=\"dashboard-header\">\r\n        <h2>Oyunlaştırma Dashboard</h2>\r\n        <p className=\"dashboard-subtitle\">\r\n          Başarılarını takip et, rozetler kazan ve liderlik tablosunda yüksel!\r\n        </p>\r\n      </div>\r\n\r\n      <div className=\"dashboard-grid\">\r\n        <div className=\"grid-item points-section\">\r\n          <PointsDisplay showHistory={true} />\r\n        </div>\r\n\r\n        <div className=\"grid-item level-section\">\r\n          <LevelDisplay showMilestones={true} />\r\n        </div>\r\n\r\n        <div className=\"grid-item badges-section\">\r\n          <BadgeCollection showProgress={true} />\r\n        </div>\r\n\r\n        <div className=\"grid-item leaderboard-section\">\r\n          <Leaderboard showNearby={true} limit={10} />\r\n        </div>\r\n\r\n        {stats && stats.recent_achievements.length > 0 && (\r\n          <div className=\"grid-item achievements-section\">\r\n            <div className=\"section-card\">\r\n              <h3>Son Başarılar 🎉</h3>\r\n              <div className=\"achievements-grid\">\r\n                {stats.recent_achievements.map((badge) => (\r\n                  <div key={badge.badge_id} className=\"achievement-card\">\r\n                    <div className=\"achievement-icon-large\">{badge.icon}</div>\r\n                    <div className=\"achievement-name\">{badge.name}</div>\r\n                    <div className=\"achievement-rarity\">{badge.rarity}</div>\r\n                    <div className=\"achievement-points\">+{badge.points} puan</div>\r\n                  </div>\r\n                ))}\r\n              </div>\r\n            </div>\r\n          </div>\r\n        )}\r\n\r\n        {stats && stats.leaderboard_rank && (\r\n          <div className=\"grid-item rank-section\">\r\n            <div className=\"section-card rank-card\">\r\n              <h3>Sıralamanız</h3>\r\n              <div className=\"rank-display\">\r\n                <div className=\"rank-number\">#{stats.leaderboard_rank.rank}</div>\r\n                <div className=\"rank-info\">\r\n                  <div className=\"rank-percentile\">\r\n                    Top {Math.round(100 - stats.leaderboard_rank.percentile)}%\r\n                  </div>\r\n                  <div className=\"rank-total\">\r\n                    {stats.leaderboard_rank.total_users.toLocaleString('tr-TR')} kullanıcı arasında\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        )}\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GamificationDashboard;\r\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\frontend\\src\\components\\Gamification\\Leaderboard.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":26,"column":50,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":26,"endColumn":53,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[831,834],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[831,834],"text":"never"},"desc":"Use `never` instead,