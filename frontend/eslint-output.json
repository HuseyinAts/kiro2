le: 1 }}\n              transition={{ duration: 0.5 }}\n            >\n              <GlassCard glassIntensity=\"medium\" elevated>\n                <Box sx={{ textAlign: 'center', py: 8 }}>\n                  <Box\n                    sx={{\n                      width: 120,\n                      height: 120,\n                      borderRadius: '50%',\n                      background: modernColors.gradients.forest,\n                      display: 'flex',\n                      alignItems: 'center',\n                      justifyContent: 'center',\n                      mx: 'auto',\n                      mb: 3,\n                    }}\n                  >\n                    <Class sx={{ fontSize: 64, color: 'white' }} />\n                  </Box>\n                  <Typography variant=\"h5\" sx={{ fontWeight: 700, mb: 2 }}>\n                    Henüz sınıfınız bulunmuyor\n                  </Typography>\n                  <Typography variant=\"body1\" color=\"text.secondary\" sx={{ mb: 4 }}>\n                    İlk sınıfınızı oluşturmak için aşağıdaki butona tıklayın\n                  </Typography>\n                  <ModernButton\n                    variant=\"gradient\"\n                    gradient={modernColors.gradients.forest}\n                    icon={<Add />}\n                    onClick={() => setCreateDialogOpen(true)}\n                    glow\n                  >\n                    Sınıf Oluştur\n                  </ModernButton>\n                </Box>\n              </GlassCard>\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n        {/* FAB for creating class */}\n        {classes.length > 0 && (\n          <Fab\n            color=\"primary\"\n            aria-label=\"add class\"\n            sx={{\n              position: 'fixed',\n              bottom: 24,\n              right: 24,\n              background: modernColors.gradients.forest,\n              '&:hover': {\n                background: modernColors.gradient