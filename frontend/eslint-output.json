tion[], result: DetectionResult) => {\n    setDetectedQuestions(questions);\n    setLastResult(result);\n  };\n\n  // Handle cropped questions\n  const handleQuestionsCropped = (cropped: CroppedQuestion[]) => {\n    setCroppedQuestions(cropped);\n  };\n\n  // Save questions to bank (placeholder)\n  const handleSaveToBank = async () => {\n    // TODO: Implement saving to question bank\n    setSavedCount(croppedQuestions.length);\n    alert(`${croppedQuestions.length} soru soru bankasına kaydedildi!`);\n  };\n\n  return (\n    <Container maxWidth=\"lg\" sx={{ py: 4 }}>\n      {/* Header */}\n      <Box sx={{ mb: 4 }}>\n        <Typography variant=\"h4\" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>\n          <CameraIcon color=\"primary\" />\n          Soru Yükleme\n        </Typography>\n        <Typography variant=\"body1\" color=\"textSecondary\">\n          Sınav sayfalarını yükleyin, yapay zeka ile soruları otomatik tespit edin.\n        </Typography>\n      </Box>\n\n      {/* Stats Cards */}\n      {lastResult && (\n        <Grid container spacing={2} sx={{ mb: 3 }}>\n          <Grid item xs={6} sm={3}>\n            <Card sx={{ bgcolor: 'primary.light', color: 'primary.contrastText' }}>\n              <CardContent sx={{ textAlign: 'center' }}>\n                <Typography variant=\"h3\">{lastResult.questions_count}</Typography>\n                <Typography variant=\"body2\">Tespit Edilen Soru</Typography>\n              </CardContent>\n            </Card>\n          </Grid>\n          <Grid item xs={6} sm={3}>\n            <Card sx={{ bgcolor: 'secondary.light', color: 'secondary.contrastText' }}>\n              <CardContent sx={{ textAlign: 'center' }}>\n                <Typography variant=\"h3\">{lastResult.total_detections}</Typography>\n                <Typography variant=\"body2\">Toplam Tespit</Typography>\n              </CardContent>\n            </Card>\n          </Grid>\n          <Grid item xs={6} sm={3}>\n            <Card sx={{ bgcolor: 'success.light', color: 'success.contrastText' }}>\n              <CardContent sx={{ textAlign: 'center' }}>\n                <Typography variant=\"h3\">{croppedQuestions.length}</Typography>\n                <Typography variant=\"body2\">Kırpılmış Soru</Typography>\n              </CardContent>\n            </Card>\n          </Grid>\n          <Grid item xs={6} sm={3}>\n            <Card sx={{ bgcolor: 'info.light', color: 'info.contrastText' }}>\n              <CardContent sx={{ textAlign: 'center' }}>\n                <Typography variant=\"h3\">{lastResult.processing_time_ms.toFixed(0)}</Typography>\n                <Typography variant=\"body2\">ms İşlem Süresi</Typography>\n              </CardContent>\n            </Card>\n          </Grid>\n        </Grid>\n      )}\n\n      {/* Tabs */}\n      <Paper sx={{ mb: 3 }}>\n        <Tabs value={tab} onChange={(_, v) => setTab(v)} variant=\"fullWidth\">\n          <Tab icon={<UploadIcon />} label=\"Tek Görsel\" />\n          <Tab icon={<GalleryIcon />} label=\"Toplu Yükleme\" disabled />\n          <Tab icon={<CameraIcon />} label=\"Kamera\" disabled />\n        </Tabs>\n      </Paper>\n\n      {/* Single Upload Tab */}\n      <TabPanel value={tab} index={0}>\n        <Grid container spacing={3}>\n          <Grid item xs={12} md={8}>\n            <YOLOQuestionDetector\n              onQuestionsDetected={handleQuestionsDetected}\n              onQuestionsCropped={handleQuestionsCropped}\n              confidence={0.25}\n              autoCrop={false}\n            />\n          </Grid>\n\n          <Grid item xs={12} md={4}>\n            {/* Instructions */}\n            <Paper sx={{ p: 2, mb: 2 }}>\n              <Typography variant=\"subtitle2\" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>\n                <AIIcon color=\"primary\" />\n                Nasıl Çalışır?\n              </Typography>\n              <Box component=\"ol\" sx={{ pl: 2, m: 0 }}>\n                <Typography component=\"li\" variant=\"body2\" sx={{ mb: 1 }}>\n                  Sınav sayfası görselini yükleyin\n                </Typography>\n                <Typography component=\"li\" variant=\"body2\" sx={{ mb: 1 }}>\n                  \"Soruları Tespit Et\" butonuna tıklayın\n                </Typography>\n                <Typography component=\"li\" variant=\"body2\" sx={{ mb: 1 }}>\n                  AI otomatik olarak soruları, cevapları ve metadata'yı tespit eder\n                </Typography>\n                <Typography component=\"li\" variant=\"body2\">\n                  Tespit edilen soruları kırpıp soru bankasına kaydedin\n                </Typography>\n              </Box>\n            </Paper>\n\n            {/* Detection Classes */}\n            <Paper sx={{ p: 2, mb: 2 }}>\n              <Typography variant=\"subtitle2\" gutterBottom>\n                Tespit Edilen Öğeler\n              </Typography>\n              <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 0.5 }}>\n                {Object.entries(CLASS_LABELS).map(([key, label]) => (\n                  <Chip key={key} label={label} size=\"small\" variant=\"outlined\" />\n                ))}\n              </Box>\n            </Paper>\n\n            {/* Model Info */}\n            <Paper sx={{ p: 2, mb: 2 }}>\n              <Typography variant=\"subtitle2\" gutterBottom>\n                Model Bilgisi\n              </Typography>\n              <Typography variant=\"body2\" color=\"textSecondary\">\n                YOLO11m • mAP@50: 97.5%\n              </Typography>\n              <Typography variant=\"body2\" color=\"textSecondary\">\n                141 görsel ile eğitildi\n              </Typography>\n            </Paper>\n\n            {/* Save Button */}\n            {croppedQuestions.length > 0 && (\n              <Button\n                variant=\"contained\"\n                color=\"success\"\n                fullWidth\n                size=\"large\"\n                startIcon={<SuccessIcon />}\n                onClick={handleSaveToBank}\n              >\n                {croppedQuestions.length} Soruyu Kaydet\n              </Button>\n            )}\n          </Grid>\n        </Grid>\n      </TabPanel>\n\n      {/* Batch Upload Tab */}\n      <TabPanel value={tab} index={1}>\n        <Alert severity=\"info\">\n          Toplu yükleme özelliği yakında eklenecek.\n        </Alert>\n      </TabPanel>\n\n      {/* Camera Tab */}\n      <TabPanel value={tab} index={2}>\n        <Alert severity=\"info\">\n          Kamera ile çekim özelliği yakında eklenecek.\n        </Alert>\n      </TabPanel>\n\n      {/* Saved Success */}\n      {savedCount > 0 && (\n        <Alert severity=\"success\" sx={{ mt: 2 }} onClose={() => setSavedCount(0)}>\n          {savedCount} soru başarıyla soru bankasına kaydedildi!\n        </Alert>\n      )}\n    </Container>\n  );\n};\n\nexport default QuestionUploadPage;\n","usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\Users\\husey\\kiro2\\frontend\\src\\pages\\RBACTestPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-multiple-empty-lines","replacedBy":[]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"object-curly-spacing","replacedBy":[]},{"ruleId":"array-bracket-spacing","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","repl