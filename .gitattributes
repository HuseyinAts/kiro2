*.jsonl filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text

# Line ending normalization
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Goc artefaktlari (id listeleri) — araclar LF yazar, `core.autocrlf=true` bunlari
# checkout'ta CRLF'e cevirirdi ve secici her kosumda agaci KIRLI gosterirdi.
# Determinizm iddiasi (iki kosum birebir) ancak bu pin ile olculebilir kalir.
backend/scripts/quality/y11_*_aday.txt text eol=lf
backend/scripts/quality/y11_*_kumesi.txt text eol=lf
