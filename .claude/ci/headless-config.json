{
  "$schema": "https://claude.ai/schemas/headless-config.json",
  "version": "1.0.0",
  "description": "KIRO2 Claude Code Headless Mode Configuration",

  "headless": {
    "enabled": true,
    "timeout": 600000,
    "maxRetries": 3,
    "exitOnError": true
  },

  "authentication": {
    "method": "api_key",
    "keyEnvVar": "ANTHROPIC_API_KEY"
  },

  "permissions": {
    "autoApprove": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(pytest*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "requireApproval": [
      "Edit",
      "Write",
      "Bash(git commit*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(DROP*)",
      "Bash(DELETE FROM*)"
    ]
  },

  "tasks": {
    "prReview": {
      "enabled": true,
      "checks": [
        "lint",
        "typecheck",
        "test",
        "security"
      ],
      "autoComment": true
    },
    "codeQuality": {
      "enabled": true,
      "threshold": 80
    },
    "testRunner": {
      "enabled": true,
      "coverage": true,
      "coverageThreshold": 60
    }
  },

  "output": {
    "format": "json",
    "logLevel": "info",
    "artifacts": {
      "enabled": true,
      "path": ".claude/ci/artifacts"
    }
  },

  "environment": {
    "inherit": [
      "ANTHROPIC_API_KEY",
      "GITHUB_TOKEN",
      "DATABASE_URL",
      "REDIS_URL"
    ],
    "set": {
      "CLAUDE_HEADLESS": "1",
      "CI": "true"
    }
  },

  "hooks": {
    "preRun": "echo 'Starting Claude Code CI'",
    "postRun": "echo 'Claude Code CI completed'",
    "onError": "echo 'Claude Code CI failed'"
  },

  "reporting": {
    "github": {
      "enabled": true,
      "checkRuns": true,
      "prComments": true
    },
    "slack": {
      "enabled": false,
      "webhook": "${SLACK_WEBHOOK_URL}"
    }
  }
}
