{
  "$schema": "https://claude.ai/schemas/cowork-config.json",
  "version": "1.0.0",
  "description": "KIRO2 Team Collaboration Configuration",

  "team": {
    "id": "kiro2-team",
    "name": "KIRO2 Development Team",
    "description": "YKS Hazırlık Platformu geliştirme ekibi"
  },

  "collaboration": {
    "enabled": true,
    "syncInterval": 5000,
    "conflictResolution": "last-write-wins",
    "lockTimeout": 300000
  },

  "roles": {
    "admin": {
      "permissions": ["*"],
      "description": "Full access"
    },
    "developer": {
      "permissions": [
        "read:*",
        "write:backend/*",
        "write:frontend/*",
        "write:.claude/*",
        "execute:tests",
        "execute:lint"
      ],
      "description": "Development access"
    },
    "reviewer": {
      "permissions": [
        "read:*",
        "comment:*",
        "approve:pr"
      ],
      "description": "Code review access"
    },
    "viewer": {
      "permissions": ["read:*"],
      "description": "Read-only access"
    }
  },

  "taskAssignment": {
    "strategy": "capability-based",
    "loadBalancing": true,
    "maxTasksPerMember": 3
  },

  "notifications": {
    "taskAssigned": true,
    "taskCompleted": true,
    "conflictDetected": true,
    "prReady": true
  },

  "sessions": {
    "maxConcurrent": 5,
    "idleTimeout": 1800000,
    "heartbeatInterval": 30000
  },

  "sync": {
    "tasks": true,
    "context": false,
    "files": true,
    "branches": [
      "main",
      "develop",
      "feature/*"
    ]
  },

  "integrations": {
    "github": {
      "enabled": true,
      "repo": "kiro2/kiro2",
      "autoSync": true
    },
    "slack": {
      "enabled": false,
      "channel": "#kiro2-dev"
    }
  }
}
