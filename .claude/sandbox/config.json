{
  "$schema": "https://claude.ai/schemas/sandbox-config.json",
  "version": "1.0.0",
  "description": "KIRO2 Claude Code Sandbox Configuration",

  "sandbox": {
    "enabled": true,
    "mode": "permissive",
    "logging": true
  },

  "network": {
    "enabled": true,
    "allowList": [
      "api.github.com",
      "pypi.org",
      "registry.npmjs.org",
      "api.anthropic.com",
      "generativelanguage.googleapis.com",
      "localhost",
      "127.0.0.1"
    ],
    "denyList": [
      "*.internal",
      "*.local",
      "10.*.*.*",
      "192.168.*.*",
      "172.16.*.*"
    ],
    "allowedPorts": [
      80, 443, 8000, 8080, 3000, 3001, 5434, 6379, 9200
    ]
  },

  "filesystem": {
    "readOnly": [
      "/etc",
      "/usr",
      "/bin",
      "/sbin",
      "C:\\Windows",
      "C:\\Program Files",
      "C:\\Program Files (x86)"
    ],
    "writable": [
      "./backend",
      "./frontend",
      "./.claude",
      "./.kiro",
      "./.github",
      "./docs",
      "./tests"
    ],
    "forbidden": [
      ".env",
      ".env.*",
      "!.env.example",
      "**/credentials*",
      "**/secrets*",
      "**/.ssh",
      "**/.aws",
      "**/.gcp",
      "**/id_rsa*",
      "**/*.pem",
      "**/*.key"
    ]
  },

  "process": {
    "maxConcurrent": 10,
    "timeout": 300000,
    "allowedCommands": [
      "python",
      "python3",
      "pip",
      "npm",
      "npx",
      "node",
      "git",
      "ruff",
      "mypy",
      "pytest",
      "alembic",
      "docker",
      "docker-compose"
    ],
    "deniedCommands": [
      "rm -rf /",
      "rm -rf *",
      "sudo",
      "su",
      "chmod 777",
      "curl | bash",
      "wget | bash"
    ]
  },

  "resources": {
    "maxMemoryMB": 4096,
    "maxCpuPercent": 80,
    "maxDiskWriteMB": 1024
  },

  "audit": {
    "enabled": true,
    "logPath": "~/.claude/logs/sandbox",
    "logRetentionDays": 30,
    "alertOnViolation": true
  }
}
