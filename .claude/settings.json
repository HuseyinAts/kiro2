{
  "permissions": {
    "allow": [
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(alembic:*)",
      "Bash(mypy:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(uvicorn:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(*--help)",
      "Bash(*--version)",
      "Bash(*-h)",
      "Bash(claude:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(DROP:*)",
      "Bash(DELETE FROM:*)",
      "Bash(TRUNCATE:*)",
      "Read(.env*)",
      "Edit(.env*)",
      "Edit(d-dataset/ocr_output/**)",
      "Edit(d-dataset/answer_keys/**)",
      "Edit(d-dataset/eslesmis_sorucevap.jsonl)",
      "Write(d-dataset/ocr_output/**)",
      "Write(d-dataset/answer_keys/**)",
      "Write(d-dataset/eslesmis_sorucevap.jsonl)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File C:/Users/husey/kiro2/.claude/hooks/pre-compact.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File C:/Users/husey/kiro2/.claude/hooks/post-tool-use.ps1"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File C:/Users/husey/kiro2/.claude/hooks/post-tool-use.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File C:/Users/husey/kiro2/.claude/hooks/pre-tool-use.ps1"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/husey/kiro2/.claude/hooks/session-init.py"
          }
        ]
      }
    ]
  },
  "contextManagement": {
    "warningThreshold": 60,
    "clearThreshold": 70,
    "progressFile": "progress.md",
    "autoCompact": false
  },
  "env": {
    "CLAUDE_CODE_TASK_LIST_ID": "kiro2-master",
    "CLAUDE_CODE_DISABLE_AUTO_COMPACT": "1"
  },
  "excludePatterns": [
    "node_modules",
    "node_modules/**",
    ".venv",
    ".venv/**",
    "venv",
    "venv/**",
    "__pycache__",
    "__pycache__/**",
    "*.pyc",
    ".git",
    ".git/**",
    "*.log",
    "dist",
    "dist/**",
    "build",
    "build/**",
    "htmlcov",
    "htmlcov/**",
    ".pytest_cache",
    ".pytest_cache/**",
    ".mypy_cache",
    ".mypy_cache/**",
    ".ruff_cache",
    ".ruff_cache/**",
    "*.egg-info",
    "*.egg-info/**",
    ".eggs",
    ".eggs/**",
    "coverage",
    ".coverage",
    ".nyc_output",
    "*.min.js",
    "*.min.css",
    "*.bundle.js",
    "*.chunk.js",
    "package-lock.json",
    "yarn.lock",
    "poetry.lock",
    ".idea",
    ".vscode",
    "*.swp",
    "*.swo",
    "tmp",
    "temp",
    ".temp",
    ".tmp"
  ],
  "model": "opus"
}
