{
  "permissions": {
    "allow": [
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(alembic:*)",
      "Bash(mypy:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(uvicorn:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(*--help)",
      "Bash(*--version)",
      "Bash(*-h)",
      "Bash(claude:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf *:*)",
      "Bash(rm -rf .:*)",
      "Bash(rmdir /s /q:*)",
      "Bash(del /s /q:*)",
      "Bash(DROP TABLE:*)",
      "Bash(DROP DATABASE:*)",
      "Bash(TRUNCATE TABLE:*)",
      "Bash(DELETE FROM:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -f:*)",
      "Bash(chmod 777:*)",
      "Bash(cat .env:*)",
      "Bash(source .env:*)",
      "Bash(. .env:*)",
      "Bash(eval :*)",
      "Read(.env*)",
      "Write(.env*)",
      "Edit(.env*)",
      "Edit(d-dataset/ocr_output/**)",
      "Edit(d-dataset/answer_keys/**)",
      "Edit(d-dataset/eslesmis_sorucevap.jsonl)",
      "Write(d-dataset/ocr_output/**)",
      "Write(d-dataset/answer_keys/**)",
      "Write(d-dataset/eslesmis_sorucevap.jsonl)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/pre-tool-use.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session-init.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session-save.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session-save.py"
          }
        ]
      }
    ]
  },
  "contextManagement": {
    "warningThreshold": 60,
    "clearThreshold": 70,
    "progressFile": "progress.md",
    "autoCompact": true
  },
  "env": {
    "CLAUDE_CODE_TASK_LIST_ID": "kiro2-master"
  },
  "excludePatterns": [
    "node_modules",
    "node_modules/**",
    ".venv",
    ".venv/**",
    "venv",
    "venv/**",
    "__pycache__",
    "__pycache__/**",
    "*.pyc",
    ".git",
    ".git/**",
    "*.log",
    "dist",
    "dist/**",
    "build",
    "build/**",
    "htmlcov",
    "htmlcov/**",
    ".pytest_cache",
    ".pytest_cache/**",
    ".mypy_cache",
    ".mypy_cache/**",
    ".ruff_cache",
    ".ruff_cache/**",
    "*.egg-info",
    "*.egg-info/**",
    ".eggs",
    ".eggs/**",
    "coverage",
    ".coverage",
    ".nyc_output",
    "*.min.js",
    "*.min.css",
    "*.bundle.js",
    "*.chunk.js",
    "package-lock.json",
    "yarn.lock",
    "poetry.lock",
    ".idea",
    ".vscode",
    "*.swp",
    "*.swo",
    "tmp",
    "temp",
    ".temp",
    ".tmp"
  ],
  "model": "opus"
}
