{
  "env": {
    "CLAUDE_CODE_TASK_LIST_ID": "kiro2-master"
  },
  "permissions": {
    "allow": [
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(alembic:*)",
      "Bash(mypy:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(uvicorn:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(*--help)",
      "Bash(*--version)",
      "Bash(*-h)",
      "Bash(claude:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf *:*)",
      "Bash(rm -rf .:*)",
      "Bash(rmdir /s /q:*)",
      "Bash(del /s /q:*)",
      "Bash(DROP TABLE:*)",
      "Bash(DROP DATABASE:*)",
      "Bash(TRUNCATE TABLE:*)",
      "Bash(DELETE FROM:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push --force-with-lease --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -f:*)",
      "Bash(chmod 777:*)",
      "Bash(cat .env:*)",
      "Bash(source .env:*)",
      "Bash(. .env:*)",
      "Bash(eval :*)",
      "Read(**/.env*)",
      "Write(**/.env*)",
      "Edit(**/.env*)",
      "Edit(d-dataset/ocr_output/**)",
      "Edit(d-dataset/answer_keys/**)",
      "Edit(d-dataset/eslesmis_sorucevap.jsonl)",
      "Write(d-dataset/ocr_output/**)",
      "Write(d-dataset/answer_keys/**)",
      "Write(d-dataset/eslesmis_sorucevap.jsonl)",

      "Read(./.archive/**)",
      "Read(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Read(./venv/**)",
      "Read(./.venv/**)",
      "Read(./frontend/coverage/**)",
      "Read(./backend/htmlcov/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/.pytest_cache/**)",
      "Read(./**/.mypy_cache/**)",
      "Read(./**/.ruff_cache/**)",
      "Read(./**/dist/**)",
      "Read(./**/build/**)"
    ]
  },
  "model": "claude-sonnet-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/husey/kiro2/.claude/hooks/pre-tool-use.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/husey/kiro2/.claude/hooks/pre-commit-check.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/husey/kiro2/.claude/hooks/session-init.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/husey/kiro2/.claude/hooks/session-save.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/husey/kiro2/.claude/hooks/session-save.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/husey/kiro2/.claude/hooks/post-edit-format.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/husey/kiro2/.claude/hooks/post-edit-typecheck.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/husey/kiro2/.claude/hooks/post-commit-checkpoint.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
