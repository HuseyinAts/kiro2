# ============================================================================
# Video API Production Dockerfile
# Learning Path Video Yükleme Sistemi - Optimized Multi-stage Build
# ============================================================================

# Build stage
FROM python:3.11-slim-bullseye as builder

# Set build arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0

# Labels
LABEL maintainer="Teknofest 2025 Eğitim Eylemci" \
      org.opencontainers.image.title="Video API Service" \
      org.opencontainers.image.description="Turkish Education Video Recommendation API" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"

# Set environment variables for build
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100

# Install system dependencies for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    gcc \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements files
COPY backend/requirements.txt /tmp/requirements.txt
COPY backend/requirements-minimal.txt /tmp/requirements-minimal.txt 2>/dev/null || true

# Install Python dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r /tmp/requirements.txt

# Copy application code
WORKDIR /build
COPY backend/ /build/

# Compile Python files for faster startup
RUN python -m compileall -b /build

# ============================================================================
# Production stage
# ============================================================================
FROM python:3.11-slim-bullseye as production

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    ENVIRONMENT=production \
    LOG_LEVEL=INFO \
    PYTHONIOENCODING=utf-8

# Install production runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    wget \
    ca-certificates \
    locales \
    locales-all \
    tzdata \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Set Turkish locale
RUN echo "tr_TR.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen tr_TR.UTF-8 && \
    update-locale LANG=tr_TR.UTF-8

ENV LC_ALL=tr_TR.UTF-8 \
    LANG=tr_TR.UTF-8 \
    LANGUAGE=tr_TR:tr

# Set timezone to Turkey
ENV TZ=Europe/Istanbul
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Create non-root user for security
RUN groupadd -r videoapi --gid=1000 && \
    useradd -r -g videoapi --uid=1000 --home-dir=/app --shell=/bin/bash videoapi

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Create application directory
WORKDIR /app

# Copy application code from builder
COPY --from=builder --chown=videoapi:videoapi /build /app

# Create necessary directories with proper permissions
RUN mkdir -p \
    /app/logs \
    /app/uploads \
    /app/temp \
    /app/cache \
    /app/static \
    /app/data && \
    chown -R videoapi:videoapi /app

# Copy production configuration
COPY .kiro/specs/learning-path-video-fix/deployment/config/production.py /app/config/ 2>/dev/null || true

# Create entrypoint script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "Starting Video API Service..."\n\
echo "Environment: ${ENVIRONMENT}"\n\
echo "Instance ID: ${INSTANCE_ID:-unknown}"\n\
echo "Version: ${APP_VERSION:-1.0.0}"\n\
\n\
# Run database migrations if needed\n\
if [ "${RUN_MIGRATIONS}" = "true" ]; then\n\
    echo "Running database migrations..."\n\
    alembic upgrade head || echo "Migration failed or not configured"\n\
fi\n\
\n\
# Warm up cache if enabled\n\
if [ "${CACHE_WARMING_ENABLED}" = "true" ]; then\n\
    echo "Warming up cache..."\n\
    python -c "from services.video_recommendation_service import warm_cache; warm_cache()" || echo "Cache warming skipped"\n\
fi\n\
\n\
# Start application\n\
echo "Starting Uvicorn server..."\n\
exec "$@"\n\
' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Create health check script
RUN echo '#!/bin/bash\n\
response=$(curl -sf http://localhost:8000/api/youtube/health || echo "failed")\n\
if [ "$response" = "failed" ]; then\n\
    exit 1\n\
fi\n\
\n\
# Check if response contains "healthy" status\n\
if echo "$response" | grep -q "\"status\":\"healthy\""; then\n\
    exit 0\n\
else\n\
    exit 1\n\
fi\n\
' > /app/healthcheck.sh && chmod +x /app/healthcheck.sh

# Create startup health check script
RUN echo '#!/bin/bash\n\
# Startup health check - verifies all dependencies\n\
python -c "\n\
import sys\n\
import asyncio\n\
from services.health_check_service import HealthCheckService\n\
\n\
async def check():\n\
    service = HealthCheckService()\n\
    result = await service.startup_health_check()\n\
    if not result.success:\n\
        print(f\"Startup health check failed: {result.errors}\")\n\
        sys.exit(1)\n\
    print(\"Startup health check passed\")\n\
    sys.exit(0)\n\
\n\
asyncio.run(check())\n\
"\n\
' > /app/startup-check.sh && chmod +x /app/startup-check.sh

# Switch to non-root user
USER videoapi

# Expose port
EXPOSE 8000

# Health check configuration (Req 4.1, 4.2)
HEALTHCHECK --interval=30s \
            --timeout=10s \
            --start-period=60s \
            --retries=3 \
            CMD ["/app/healthcheck.sh"]

# Use tini as init system for proper signal handling
ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]

# Default command - Uvicorn with production settings
CMD ["uvicorn", \
     "main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--loop", "uvloop", \
     "--log-level", "info", \
     "--access-log", \
     "--no-use-colors", \
     "--proxy-headers", \
     "--forwarded-allow-ips", "*"]
